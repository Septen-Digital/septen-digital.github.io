{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/demos/carls-coffee/",
        "http://localhost/demos/alder-and-pipe-plumbing/",
        "http://localhost/demos/sarahs-boutique/",
        "http://localhost/demos/greenfield-landscaping/",
        "http://localhost/demos/north-shore-fitness/"
      ],
      "settings": {
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.7
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 4000
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 350000
          }
        ],
        "unused-javascript": "off",
        "unused-css-rules": "off"
      }
    }
  }
}
