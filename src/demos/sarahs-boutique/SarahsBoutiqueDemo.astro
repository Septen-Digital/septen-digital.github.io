  <script>
    const boutiqueRoot = document.getElementById("sarahs-boutique-demo-root");
    const filterNames = ["All", "Dresses", "Outerwear", "Tops", "Accessories", "Collections"];

    const enableBoutiqueEnhancement = () => {
      if (document.documentElement.classList.contains("site-ready")) {
        boutiqueRoot?.setAttribute("data-boutique-enhanced", "true");
      }
    };

    if (document.documentElement.classList.contains("site-ready")) {
      enableBoutiqueEnhancement();
    } else {
      document.addEventListener("septen:site-ready", enableBoutiqueEnhancement, { once: true });
    }

    const applyBoutiqueFilter = (category: string) => {
      if (!boutiqueRoot || !filterNames.includes(category)) {
        return;
      }

      boutiqueRoot.dataset.boutiqueActiveFilter = category;

      boutiqueRoot.querySelectorAll<HTMLElement>("[data-boutique-filter]").forEach((filter) => {
        const isActive = filter.dataset.boutiqueFilter === category;
        filter.style.setProperty("background", isActive ? "#1e1e1c" : "white", "important");
        filter.style.setProperty("border-color", isActive ? "#1e1e1c" : "#e7e5e4", "important");
        filter.style.setProperty("color", isActive ? "white" : "#78716c", "important");
      });

      boutiqueRoot
        .querySelectorAll<HTMLElement>("[data-boutique-catalogue-card]")
        .forEach((card) => {
          const isVisible = category === "All" || card.dataset.boutiqueCategory === category;
          card.style.setProperty("display", isVisible ? "" : "none", "important");
        });
    };

    const deriveBoutiqueViewFromHash = (): string | null => {
      const hash = window.location.hash || "";
      if (!hash || hash === "#" || hash === "#home") return "home";
      if (hash === `#catalogue` || hash.startsWith("#catalogue-")) return "catalogue";
      if (hash === "#about") return "about";
      if (hash === "#visit" || hash === "#visit-confirmation") return "visit";
      if (hash.startsWith("#product-")) return "product-detail";
      return null;
    };

    const deriveBoutiqueFilterFromHash = (): string => {
      const match = window.location.hash.match(/^#catalogue-(.+)$/);
      if (!match) return "All";
      const raw = match[1];
      const pretty = raw.charAt(0).toUpperCase() + raw.slice(1);
      return filterNames.includes(pretty) ? pretty : "All";
    };

    const setBoutiqueView = (view: string) => {
      boutiqueRoot?.querySelectorAll<HTMLElement>("[data-boutique-panel]").forEach((panel) => {
        const panelType = panel.dataset.boutiquePanel;
        if (view === "product-detail") {
          panel.dataset.boutiqueActive =
            panelType === "product-detail"
              ? panel.id === window.location.hash.slice(1)
                ? "true"
                : "false"
              : "false";
        } else {
          panel.dataset.boutiqueActive = panelType === view ? "true" : "false";
        }
      });
    };

    const syncBoutiqueStateFromLocation = () => {
      const nextView = deriveBoutiqueViewFromHash();
      if (nextView) {
        setBoutiqueView(nextView);
      }
      applyBoutiqueFilter(deriveBoutiqueFilterFromHash());
    };

    boutiqueRoot?.querySelectorAll<HTMLAnchorElement>("[data-boutique-nav]").forEach((link) => {
      link.addEventListener("click", () => {
        const view = link.dataset.boutiqueNav;
        if (view) {
          setBoutiqueView(view);
        }
      });
    });

    const initialFilter = deriveBoutiqueFilterFromHash();
    applyBoutiqueFilter(initialFilter);
    syncBoutiqueStateFromLocation();
    window.addEventListener("hashchange", syncBoutiqueStateFromLocation);

    boutiqueRoot?.addEventListener("click", (event) => {
      const filterLink =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>("a[data-boutique-filter]")
          : null;
      const filterHref = filterLink?.getAttribute("href");

      if (filterLink && filterHref?.startsWith("#catalogue-")) {
        event.preventDefault();
        const scrollTop = window.scrollY;
        const scrollLeft = window.scrollX;
        const category = filterLink.dataset.boutiqueFilter;
        if (!category) {
          return;
        }

        history.pushState(null, "", filterHref);
        applyBoutiqueFilter(category);
        setBoutiqueView("catalogue");
        window.requestAnimationFrame(() => {
          window.scrollTo({ top: scrollTop, left: scrollLeft, behavior: "auto" });
        });
        return;
      }

      const selectLink =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>("a[data-boutique-select-product]")
          : null;
      if (selectLink) {
        const href = selectLink.getAttribute("href");
        const match = href?.match(/^#(product-.+)$/);
        if (!match) return;
        const productHash = match[1];
        setBoutiqueView("product-detail");
        setTimeout(() => {
          boutiqueRoot
            ?.querySelectorAll<HTMLElement>('[data-boutique-panel="product-detail"]')
            .forEach((panel) => {
              panel.dataset.boutiqueActive = panel.id === productHash ? "true" : "false";
            });
        }, 0);
        return;
      }

      const goViewLink =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>("a[data-boutique-go-view]")
          : null;
      if (goViewLink?.dataset.boutiqueGoView) {
        setBoutiqueView(goViewLink.dataset.boutiqueGoView);
        return;
      }

      const openModalLink =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>("a[data-boutique-open-modal]")
          : null;
      if (openModalLink) {
        setBoutiqueView("visit");
        return;
      }
    });
  </script>
</div>
