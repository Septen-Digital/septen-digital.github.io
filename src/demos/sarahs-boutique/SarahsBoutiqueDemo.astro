---
import { Image } from "astro:assets";
import SarahsBoutiqueIsland from "./SarahsBoutiqueIsland";
import BoutiqueIcon from "./BoutiqueIcon.astro";
import {
  getSarahsBoutiqueCategoryAnchorId,
  getSarahsBoutiqueProductDetailId,
  sarahsBoutiqueCategories,
  sarahsBoutiqueFeaturedProducts,
  sarahsBoutiqueHeroImage,
  sarahsBoutiqueInventory,
  sarahsBoutiqueRootId,
  sarahsBoutiqueStoreImage,
  sarahsBoutiqueViewIds,
  sarahsBoutiqueVisitConfirmationId,
} from "./sarahsBoutique.data";

const rootId = sarahsBoutiqueRootId;
const catalogueId = sarahsBoutiqueViewIds.catalogue;
const homeId = sarahsBoutiqueViewIds.home;
const aboutId = sarahsBoutiqueViewIds.about;
const visitId = sarahsBoutiqueViewIds.visit;
const visitConfirmationId = sarahsBoutiqueVisitConfirmationId;
const collectionProducts = sarahsBoutiqueInventory.filter(
  (product) => product.category === "Collections",
);
---

<div
  id={rootId}
  class="bg-[#FAF8F5] min-h-screen text-[#1E1E1C] font-sans antialiased relative flex flex-col"
>
  <style is:global>
    /* JS-enhanced mode swaps between panels in place. The no-JS fallback below
       still works through anchor targets, so both states live in one component. */
    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-panel] {
      display: none;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-panel][data-boutique-active="true"] {
      display: block;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-visit-success] {
      display: none;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-visit-success][data-boutique-active="true"] {
      display: block;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-collections-links] {
      display: none;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-collections-links][data-boutique-active="true"] {
      display: flex;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-anchor-target] {
      scroll-margin-top: 8.5rem;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-panel] {
      scroll-margin-top: 8.6rem;
    }

    @media (min-width: 48rem) {
      #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-anchor-target] {
        scroll-margin-top: 9.5rem;
      }

      #sarahs-boutique-demo-root[data-boutique-enhanced="true"] [data-boutique-panel] {
        scroll-margin-top: 9.6rem;
      }
    }

    #sarahs-boutique-demo-root [data-boutique-panel="home"] .image-skeleton,
    #sarahs-boutique-demo-root [data-boutique-panel="home"] .image-skeleton.is-media-pending,
    #sarahs-boutique-demo-root [data-boutique-panel="home"] .image-skeleton.is-loaded {
      border-radius: 0 !important;
      clip-path: inset(0 round 0) !important;
      transform: none !important;
    }

    #sarahs-boutique-demo-root [data-boutique-anchor-target],
    #sarahs-boutique-demo-root [data-boutique-panel] {
      scroll-margin-top: 0;
    }

    #sarahs-boutique-demo-root [data-boutique-panel="catalogue"] > div,
    #sarahs-boutique-demo-root [data-boutique-panel="product-detail"] > div {
      padding-top: 0.75rem !important;
    }

    #sarahs-boutique-demo-root [data-boutique-panel="about"] > div,
    #sarahs-boutique-demo-root [data-boutique-panel="visit"] > div {
      padding-top: 1rem !important;
    }
  </style>

  <noscript>
    <style>
      /* Without JS, the boutique behaves like a multi-view document navigated
         by fragment targets instead of runtime state changes. */
      #sarahs-boutique-demo-root [data-boutique-panel="catalogue"],
      #sarahs-boutique-demo-root [data-boutique-panel="about"],
      #sarahs-boutique-demo-root [data-boutique-panel="visit"],
      #sarahs-boutique-demo-root [data-boutique-panel="product-detail"],
      #sarahs-boutique-demo-root [data-boutique-visit-success],
      #sarahs-boutique-demo-root [data-boutique-collections-links] {
        display: none !important;
      }

      #sarahs-boutique-demo-root:has(#boutique-catalogue:target) [data-boutique-panel="home"],
      #sarahs-boutique-demo-root:has(#boutique-about:target) [data-boutique-panel="home"],
      #sarahs-boutique-demo-root:has(#boutique-visit:target) [data-boutique-panel="home"],
      #sarahs-boutique-demo-root:has([data-boutique-category-target]:target) [data-boutique-panel="home"],
      #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target) [data-boutique-panel="home"],
      #sarahs-boutique-demo-root:has(#boutique-visit-confirmation:target) [data-boutique-panel="home"] {
        display: none !important;
      }

      #boutique-home:target,
      #boutique-catalogue:target,
      #boutique-about:target,
      #boutique-visit:target {
        display: block !important;
      }

      #sarahs-boutique-demo-root:has([data-boutique-category-target]:target) [data-boutique-panel="catalogue"],
      #sarahs-boutique-demo-root:has(#boutique-visit-confirmation:target) [data-boutique-panel="visit"] {
        display: block !important;
      }

      #sarahs-boutique-demo-root:has(#boutique-category-dresses:target) [data-boutique-catalogue-card]:not([data-boutique-category="Dresses"]),
      #sarahs-boutique-demo-root:has(#boutique-category-outerwear:target) [data-boutique-catalogue-card]:not([data-boutique-category="Outerwear"]),
      #sarahs-boutique-demo-root:has(#boutique-category-tops:target) [data-boutique-catalogue-card]:not([data-boutique-category="Tops"]),
      #sarahs-boutique-demo-root:has(#boutique-category-accessories:target) [data-boutique-catalogue-card]:not([data-boutique-category="Accessories"]),
      #sarahs-boutique-demo-root:has(#boutique-category-collections:target) [data-boutique-catalogue-card]:not([data-boutique-category="Collections"]) {
        display: none !important;
      }

      #sarahs-boutique-demo-root:has(#boutique-catalogue:target) [data-boutique-filter="All"],
      #sarahs-boutique-demo-root:has(#boutique-category-all:target) [data-boutique-filter="All"],
      #sarahs-boutique-demo-root:has(#boutique-category-dresses:target) [data-boutique-filter="Dresses"],
      #sarahs-boutique-demo-root:has(#boutique-category-outerwear:target) [data-boutique-filter="Outerwear"],
      #sarahs-boutique-demo-root:has(#boutique-category-tops:target) [data-boutique-filter="Tops"],
      #sarahs-boutique-demo-root:has(#boutique-category-accessories:target) [data-boutique-filter="Accessories"],
      #sarahs-boutique-demo-root:has(#boutique-category-collections:target) [data-boutique-filter="Collections"] {
        background: #1e1e1c !important;
        border-color: #1e1e1c !important;
        color: #fff !important;
      }

      #sarahs-boutique-demo-root:has(#boutique-category-collections:target) [data-boutique-collections-links] {
        display: flex !important;
      }

      #sarahs-boutique-demo-root [data-boutique-panel="product-detail"]:target {
        display: block !important;
      }

      #sarahs-boutique-demo-root [data-boutique-anchor-target],
      #sarahs-boutique-demo-root [data-boutique-panel] {
        scroll-margin-top: 8rem !important;
      }

      #sarahs-boutique-demo-root [data-boutique-category-target] {
        scroll-margin-top: 8.5rem !important;
      }

      @media (min-width: 48rem) {
        #sarahs-boutique-demo-root [data-boutique-anchor-target],
        #sarahs-boutique-demo-root [data-boutique-panel] {
          scroll-margin-top: 9rem !important;
        }

        #sarahs-boutique-demo-root [data-boutique-category-target] {
          scroll-margin-top: 9.5rem !important;
        }
      }

      [data-boutique-panel] [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
        will-change: auto !important;
      }

      #sarahs-boutique-demo-root [data-boutique-visit-success] {
        display: none !important;
      }

      #boutique-visit-confirmation:target {
        display: block !important;
      }
    </style>
  </noscript>

  <nav
    class="bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-40"
  >
    <div
      class="max-w-6xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <a
        href={`#${homeId}`}
        data-boutique-go-view="home"
        class="font-serif text-lg tracking-[0.25em] bg-transparent text-[#1E1E1C] font-bold cursor-pointer hover:opacity-80 decoration-none"
      >
        SARAH'S BOUTIQUE
      </a>

      <div
        class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-xs font-semibold uppercase tracking-widest text-[#1E1E1C]"
      >
        <a
          href={`#${homeId}`}
          data-boutique-nav="home"
          class="nav-tab hover:text-[#E29578] cursor-pointer decoration-none"
        >
          Home
        </a>
        <a
          href={`#${catalogueId}`}
          data-boutique-nav="catalogue"
          class="nav-tab hover:text-[#E29578] cursor-pointer decoration-none"
        >
          Catalogue
        </a>
        <a
          href={`#${aboutId}`}
          data-boutique-nav="about"
          class="nav-tab hover:text-[#E29578] cursor-pointer decoration-none"
        >
          About
        </a>
        <a
          href={`#${visitId}`}
          data-boutique-nav="visit"
          class="nav-tab hover:text-[#E29578] cursor-pointer decoration-none"
        >
          Visit Store
        </a>
      </div>
    </div>
  </nav>

  <div id={homeId} data-boutique-panel="home" data-boutique-active="true">
    <div
      class="animate-fade-in relative min-h-[calc(100vh-69px)] flex items-center justify-center p-8 bg-black overflow-hidden rounded-none text-center text-white"
    >
      <div class="absolute inset-0 z-0 rounded-none">
        <Image
          src={sarahsBoutiqueHeroImage}
          widths={[480, 960, 1600]}
          sizes="100vw"
          alt="Editorial style soft luxury backdrop"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-skeleton
          class="image-skeleton h-full w-full rounded-none object-cover opacity-60 filter blur-[1px]"
        />
        <div class="absolute inset-0 bg-stone-950/45"></div>
      </div>

      <div
        class="relative z-10 max-w-2xl text-center text-white space-y-6 px-4"
      >
        <span
          class="text-[10px] uppercase font-mono tracking-[0.3em] text-[#F3EFE9] font-bold block animate-slide-in-up text-center"
        >
          MONTPELLIER ARCADE • HARROGATE
        </span>
        <h1
          class="font-serif text-4xl sm:text-6xl tracking-wide font-black capitalize text-stone-55 select-none animate-fade-in"
        >
          Sarah's Boutique
        </h1>
        <p
          class="font-serif text-lg sm:text-xl italic text-[#FAF8F5] leading-relaxed font-light"
        >
          "Soft luxury garments designed under northern winds. Boiled wool, raw
          silk, and un-dyed cashmere knitwear crafted to last."
        </p>
        <div class="w-12 h-px bg-white/40 mx-auto my-6"></div>

        <a
          href={`#${catalogueId}`}
          data-boutique-go-view="catalogue"
          class="bg-white hover:bg-[#FAF8F5] text-stone-950 font-bold px-8 py-4 rounded-sm text-xs uppercase tracking-widest transition-all hover-button-polish cursor-pointer shadow-md inline-flex items-center gap-2 decoration-none"
        >
          <span>Explore The Catalogue</span>
          <BoutiqueIcon name="ChevronRight" className="w-4 h-4" />
        </a>
      </div>
    </div>

    <section class="bg-[#FAF8F5] py-16 border-t border-stone-200/60 text-left">
      <div class="max-w-6xl mx-auto px-6">
        <h2
          class="font-serif text-2xl font-bold tracking-tight mb-8"
          data-reveal="fade"
        >
          Autumn Featured Highlights
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            sarahsBoutiqueFeaturedProducts.map((product, index) => (
              <a
                href={`#${getSarahsBoutiqueProductDetailId(product.id)}`}
                data-boutique-select-product={product.id}
                data-reveal="card"
                data-reveal-delay={String(index * 80)}
                class="featured-card bg-white border rounded p-4 shadow-xs space-y-3 cursor-pointer group hover:border-[#E29578] transition-colors hover-card-polish text-left decoration-none"
              >
                <div class="aspect-square rounded overflow-hidden bg-stone-50">
                  <Image
                    src={product.image}
                    widths={[320, 560, 760]}
                    sizes="(min-width: 48rem) 20rem, 100vw"
                    alt={product.name}
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                    data-skeleton
                    class="image-skeleton w-full h-full object-cover group-hover:scale-102 transition-transform duration-200"
                  />
                </div>
                <div>
                  <h3 class="font-serif font-black text-sm text-stone-900">
                    {product.name}
                  </h3>
                  <p class="text-xs text-[#E29578] font-mono mt-0.5">
                    {product.price}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <div id={catalogueId} data-boutique-panel="catalogue">
    <div class="animate-fade-in max-w-6xl mx-auto px-6 py-12 text-left">
      <div
        class="border-b border-stone-200 pb-8 mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-6"
        data-reveal="fade"
      >
        <div class="space-y-1.5">
          <span
            class="text-[10px] uppercase font-mono text-[#E29578] tracking-widest font-black block"
            >Active Collection</span
          >
          <h1
            class="font-serif text-3xl md:text-4xl font-extrabold text-[#1E1E1C]"
          >
            The Boutique Inventory
          </h1>
          <p class="text-xs text-stone-500 max-w-xl font-serif italic">
            Sourced from family-run mills, selected by hand, and crafted for
            physical longevity. Limited seasonal drop sizes now on key display
            racks.
          </p>
        </div>

        <div
          class="bg-[#F2EDDF] border border-stone-300 p-4 rounded max-w-sm flex gap-3 text-left hover-card-polish"
          data-reveal="scale"
          data-reveal-delay="120"
        >
          <BoutiqueIcon
            name="Sparkles"
            className="w-5 h-5 text-[#E29578] shrink-0"
          />
          <div class="space-y-0.5">
            <p class="text-xs font-bold text-stone-800">
              Autumn Drop II Arrived
            </p>
            <p class="text-[10px] text-stone-500 leading-normal">
              Curated coat arrangements and double wool blends are now available
              for exclusive store fitting appointment locks.
            </p>
          </div>
        </div>
      </div>

      <div
        class="flex flex-wrap gap-2.5 mb-8 border-b border-stone-200/50 pb-5"
        data-reveal="fade"
      >
        <div aria-hidden="true">
          {
            sarahsBoutiqueCategories.map((category) => (
              <span
                id={getSarahsBoutiqueCategoryAnchorId(category)}
                data-boutique-anchor-target
                data-boutique-category-target
                class="block h-0 overflow-hidden"
              ></span>
            ))
          }
        </div>
        {
          sarahsBoutiqueCategories.map((category) => (
            <a
              href={`#${getSarahsBoutiqueCategoryAnchorId(category)}`}
              data-boutique-filter={category}
              class="filter-chip px-4 py-2 border text-xs font-mono tracking-wider uppercase transition-all rounded-sm cursor-pointer bg-white border-stone-200 text-stone-500 hover:border-stone-400 hover:text-[#1E1E1C]"
              aria-pressed="false"
            >
              {category}
            </a>
          ))
        }
      </div>

      <div
        data-boutique-collections-links
        class="mb-8 hidden flex-wrap items-center gap-2.5 border-b border-stone-200/50 pb-5"
      >
        <span class="text-[10px] font-mono uppercase tracking-[0.24em] text-stone-400">
          Collection Pieces
        </span>
        {
          collectionProducts.map((product) => (
            <a
              href={`#${getSarahsBoutiqueProductDetailId(product.id)}`}
              data-boutique-select-product={product.id}
              class="rounded-sm border border-stone-200 bg-white px-3 py-2 text-[10px] font-mono uppercase tracking-[0.18em] text-stone-600 transition-colors hover:border-stone-400 hover:text-[#1E1E1C] decoration-none"
            >
              {product.name}
            </a>
          ))
        }
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          sarahsBoutiqueInventory.map((product, index) => (
            <article
              data-boutique-catalogue-card
              data-boutique-category={product.category}
              data-reveal="card"
              data-reveal-position="late"
              data-reveal-delay={String((index % 6) * 70)}
              class="bg-white border border-stone-200/60 rounded group flex flex-col justify-between overflow-hidden shadow-xs hover:border-stone-300 hover:shadow-xs transition-all duration-200 hover-card-polish text-left"
            >
              <a
                href={`#${getSarahsBoutiqueProductDetailId(product.id)}`}
                data-boutique-select-product={product.id}
                class="product-grid-entry cursor-pointer text-left bg-transparent p-0 decoration-none"
              >
                <div class="aspect-4/5 overflow-hidden bg-stone-100 relative">
                  <Image
                    src={product.image}
                    widths={[320, 560, 760]}
                    sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw"
                    alt={product.name}
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                    data-skeleton
                    class="image-skeleton w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                  />
                  <span class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs text-stone-900 border border-stone-200 text-[9px] font-mono font-bold px-2.5 py-0.5 rounded-sm">
                    {product.category}
                  </span>
                </div>

                <div class="p-5 text-left space-y-1.5">
                  <div class="flex justify-between items-baseline gap-2">
                    <h3 class="font-serif font-black text-md text-[#1E1E1C] group-hover:text-[#E29578] transition-colors leading-tight">
                      {product.name}
                    </h3>
                    <span class="font-mono text-sm text-[#E29578] font-bold shrink-0">
                      {product.price}
                    </span>
                  </div>
                  <p class="text-xs text-stone-500 leading-relaxed font-sans line-clamp-2">
                    {product.shortDesc}
                  </p>
                </div>
              </a>

              <div class="p-5 pt-0 border-t border-stone-50 flex items-center justify-between">
                <a
                  href={`#${getSarahsBoutiqueProductDetailId(product.id)}`}
                  data-boutique-select-product={product.id}
                  class="view-details-txt text-[10px] font-mono tracking-widest uppercase underline text-stone-500 hover:text-stone-950 cursor-pointer decoration-none"
                >
                  View Details
                </a>
                <a
                  href={`#${visitId}`}
                  data-boutique-open-modal
                  class="reserve-fitting-btn bg-[#1E1E1C] hover:bg-[#32322E] text-white px-3 py-1.5 rounded-sm text-[9px] font-mono uppercase tracking-widest hover-button-polish cursor-pointer decoration-none"
                >
                  Reserves Fitting
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  {
    sarahsBoutiqueInventory.map((product) => (
      <div
        id={getSarahsBoutiqueProductDetailId(product.id)}
        data-boutique-panel="product-detail"
        data-boutique-product-id={product.id}
      >
        <div class="animate-fade-in max-w-5xl mx-auto px-6 py-12 text-left">
          <a
            href={`#${catalogueId}`}
            data-boutique-go-view="catalogue"
            class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-stone-500 hover:text-stone-950 mb-8 cursor-pointer decoration-none"
            data-reveal="fade"
          >
            <BoutiqueIcon name="ArrowLeft" className="w-4 h-4" />
            <span>Return to Inventory</span>
          </a>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
            <div
              class="md:col-span-6 bg-stone-50 border border-stone-200/60 rounded overflow-hidden shadow-xs hover-card-polish"
              data-reveal="scale"
              data-reveal-delay="120"
            >
              <Image
                src={product.image}
                widths={[320, 560, 760]}
                sizes="(min-width: 48rem) 50vw, 100vw"
                alt={product.name}
                loading="lazy"
                fetchpriority="low"
                decoding="async"
                data-skeleton
                class="image-skeleton w-full h-auto object-cover max-h-[600px]"
              />
            </div>

            <div
              class="md:col-span-6 space-y-6"
              data-reveal="fade"
              data-reveal-delay="180"
            >
              <div class="border-b border-stone-200 pb-4 space-y-2">
                <span class="text-[10px] font-mono tracking-widest uppercase font-black text-[#E29578] block">
                  Archive Item No. P-
                  {product.id.replace("prod-", "").padStart(3, "0")}
                </span>
                <h1 class="font-serif text-3xl font-bold text-[#1E1E1C]">
                  {product.name}
                </h1>
                <p class="font-mono text-xl text-[#E29578] font-bold">
                  {product.price}
                </p>
              </div>

              <div class="space-y-4">
                <p class="text-sm text-stone-600 leading-relaxed font-sans">
                  {product.longDesc}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-stone-200/60 pt-4">
                  <div class="space-y-1 bg-stone-100/50 p-3.5 rounded border border-stone-200/20">
                    <span class="text-[9px] font-mono text-stone-400 font-bold block uppercase tracking-widest">
                      Sizing & Cuts
                    </span>
                    <p class="text-xs text-stone-600 leading-relaxed font-serif italic">
                      {product.sizing}
                    </p>
                  </div>

                  <div class="space-y-1 bg-stone-100/50 p-3.5 rounded border border-stone-200/20">
                    <span class="text-[9px] font-mono text-stone-400 font-bold block uppercase tracking-widest">
                      Fibers & Materials
                    </span>
                    <p class="text-xs text-stone-600 leading-relaxed font-serif italic">
                      {product.materials}
                    </p>
                  </div>
                </div>
              </div>

              <div class="pt-6 border-t border-stone-200/60 space-y-3">
                <a
                  href={`#${visitId}`}
                  data-boutique-open-modal
                  class="w-full bg-[#1E1E1C] hover:bg-[#32322E] text-[#FAF8F5] text-xs font-mono uppercase tracking-widest py-4 rounded-sm transition-colors hover-button-polish cursor-pointer shadow-md inline-flex items-center justify-center gap-2 decoration-none"
                >
                  <BoutiqueIcon name="ShoppingBag" className="w-4 h-4" />
                  <span>Buy Now (Fitting Reserved)</span>
                </a>
                <p class="text-[10px] text-stone-400 font-mono text-center italic">
                  Select to route this unique item directly to Montpellier
                  Arcade closet racks or safe home dispatch.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))
  }

  <div id={aboutId} data-boutique-panel="about">
