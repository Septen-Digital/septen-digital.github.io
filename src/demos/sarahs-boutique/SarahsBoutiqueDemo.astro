---
import { Image } from "astro:assets";
import BoutiqueIcon from "./BoutiqueIcon.astro";
import {
  getSarahsBoutiqueCategoryAnchorId,
  getSarahsBoutiqueProductDetailId,
  sarahsBoutiqueCategories,
  sarahsBoutiqueFeaturedProducts,
  sarahsBoutiqueHeroImage,
  sarahsBoutiqueInventory,
  sarahsBoutiqueRootId,
  sarahsBoutiqueStoreImage,
  sarahsBoutiqueViewIds,
  sarahsBoutiqueVisitConfirmationId,
} from "./SarahsBoutique.data";

const rootId = sarahsBoutiqueRootId;
const catalogueId = sarahsBoutiqueViewIds.catalogue;
const homeId = sarahsBoutiqueViewIds.home;
const aboutId = sarahsBoutiqueViewIds.about;
const visitId = sarahsBoutiqueViewIds.visit;
const visitConfirmationId = sarahsBoutiqueVisitConfirmationId;
const collectionProducts = sarahsBoutiqueInventory.filter(
  (product) => product.category === "Collections",
);
---

<div
  id={rootId}
  class="bg-[var(--sarahs-bg-warm)] min-h-screen text-[var(--sarahs-text-ink)] font-sans antialiased relative flex flex-col"
>
  <style is:global>
    #sarahs-boutique-demo-root[data-boutique-enhanced]
      [data-boutique-panel="catalogue"]:not([data-boutique-active="true"]),
    #sarahs-boutique-demo-root[data-boutique-enhanced]
      [data-boutique-panel="about"]:not([data-boutique-active="true"]),
    #sarahs-boutique-demo-root[data-boutique-enhanced]
      [data-boutique-panel="visit"]:not([data-boutique-active="true"]),
    #sarahs-boutique-demo-root[data-boutique-enhanced]
      [data-boutique-panel="product-detail"]:not([data-boutique-active="true"]),
    #sarahs-boutique-demo-root[data-boutique-enhanced] [data-boutique-visit-success],
    #sarahs-boutique-demo-root[data-boutique-enhanced] [data-boutique-collections-links] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#about:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#visit:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#visit-confirmation:target) [data-boutique-panel="home"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue:target)
      [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#about:target)
      [data-boutique-panel="about"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#visit:target)
      [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(
        [data-boutique-panel="product-detail"]:target
      )
      [data-boutique-panel="product-detail"]:target,
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#visit-confirmation:target)
      [data-boutique-panel="visit"] {
      display: block !important;
    }

    #home:target,
    #catalogue:target,
    #about:target,
    #visit:target {
      display: block !important;
    }

    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has(#visit-confirmation:target) [data-boutique-panel="visit"] {
      display: block !important;
    }

    #sarahs-boutique-demo-root:has(#catalogue-dresses:target)
      [data-boutique-catalogue-card]:not([data-boutique-category="Dresses"]),
    #sarahs-boutique-demo-root:has(#catalogue-outerwear:target)
      [data-boutique-catalogue-card]:not([data-boutique-category="Outerwear"]),
    #sarahs-boutique-demo-root:has(#catalogue-tops:target)
      [data-boutique-catalogue-card]:not([data-boutique-category="Tops"]),
    #sarahs-boutique-demo-root:has(#catalogue-accessories:target)
      [data-boutique-catalogue-card]:not([data-boutique-category="Accessories"]),
    #sarahs-boutique-demo-root:has(#catalogue-collections:target)
      [data-boutique-catalogue-card]:not([data-boutique-category="Collections"]) {
      display: none !important;
    }

    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-all:target)
      [data-boutique-filter="All"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-dresses:target)
      [data-boutique-filter="Dresses"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-outerwear:target)
      [data-boutique-filter="Outerwear"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-tops:target)
      [data-boutique-filter="Tops"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-accessories:target)
      [data-boutique-filter="Accessories"],
    #sarahs-boutique-demo-root[data-boutique-enhanced]:has(#catalogue-collections:target)
      [data-boutique-filter="Collections"] {
      background: var(--sarahs-text-ink) !important;
      border-color: var(--sarahs-text-ink) !important;
      color: var(--color-white) !important;
    }

    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-filter="All"],
    #sarahs-boutique-demo-root:has(#catalogue-all:target) [data-boutique-filter="All"],
    #sarahs-boutique-demo-root:has(#catalogue-dresses:target) [data-boutique-filter="Dresses"],
    #sarahs-boutique-demo-root:has(#catalogue-outerwear:target) [data-boutique-filter="Outerwear"],
    #sarahs-boutique-demo-root:has(#catalogue-tops:target) [data-boutique-filter="Tops"],
    #sarahs-boutique-demo-root:has(#catalogue-accessories:target)
      [data-boutique-filter="Accessories"],
    #sarahs-boutique-demo-root:has(#catalogue-collections:target)
      [data-boutique-filter="Collections"] {
      background: var(--sarahs-text-ink) !important;
      border-color: var(--sarahs-text-ink) !important;
      color: var(--color-white) !important;
    }

    #sarahs-boutique-demo-root:has(#catalogue-collections:target)
      [data-boutique-collections-links] {
      display: flex !important;
    }

    #sarahs-boutique-demo-root[data-boutique-active-filter="Dresses"]
      [data-boutique-catalogue-card]:not([data-boutique-category="Dresses"]),
    #sarahs-boutique-demo-root[data-boutique-active-filter="Outerwear"]
      [data-boutique-catalogue-card]:not([data-boutique-category="Outerwear"]),
    #sarahs-boutique-demo-root[data-boutique-active-filter="Tops"]
      [data-boutique-catalogue-card]:not([data-boutique-category="Tops"]),
    #sarahs-boutique-demo-root[data-boutique-active-filter="Accessories"]
      [data-boutique-catalogue-card]:not([data-boutique-category="Accessories"]),
    #sarahs-boutique-demo-root[data-boutique-active-filter="Collections"]
      [data-boutique-catalogue-card]:not([data-boutique-category="Collections"]) {
      display: none !important;
    }

    #sarahs-boutique-demo-root[data-boutique-active-filter] [data-boutique-filter] {
      background: var(--color-white) !important;
      border-color: var(--color-slate-200) !important;
      color: var(--color-slate-500) !important;
    }

    #sarahs-boutique-demo-root[data-boutique-active-filter="All"] [data-boutique-filter="All"],
    #sarahs-boutique-demo-root[data-boutique-active-filter="Dresses"]
      [data-boutique-filter="Dresses"],
    #sarahs-boutique-demo-root[data-boutique-active-filter="Outerwear"]
      [data-boutique-filter="Outerwear"],
    #sarahs-boutique-demo-root[data-boutique-active-filter="Tops"] [data-boutique-filter="Tops"],
    #sarahs-boutique-demo-root[data-boutique-active-filter="Accessories"]
      [data-boutique-filter="Accessories"],
    #sarahs-boutique-demo-root[data-boutique-active-filter="Collections"]
      [data-boutique-filter="Collections"] {
      background: var(--sarahs-text-ink) !important;
      border-color: var(--sarahs-text-ink) !important;
      color: var(--color-white) !important;
    }

    #sarahs-boutique-demo-root [data-boutique-panel="product-detail"]:target {
      display: block !important;
    }

    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root:has([data-boutique-panel="product-detail"]:target)
      [data-boutique-panel="product-detail"]:not(:target) {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root:has(#catalogue:target) [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root:has([data-boutique-category-target]:target)
      [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#about:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#about:target) [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has(#about:target) [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root:has(#about:target) [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#visit:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#visit:target) [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has(#visit:target) [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has(#visit:target) [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#visit-confirmation:target) [data-boutique-panel="home"],
    #sarahs-boutique-demo-root:has(#visit-confirmation:target) [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has(#visit-confirmation:target) [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has(#visit-confirmation:target)
      [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root:has(#home:target) [data-boutique-panel="catalogue"],
    #sarahs-boutique-demo-root:has(#home:target) [data-boutique-panel="about"],
    #sarahs-boutique-demo-root:has(#home:target) [data-boutique-panel="visit"],
    #sarahs-boutique-demo-root:has(#home:target) [data-boutique-panel="product-detail"] {
      display: none !important;
    }

    #sarahs-boutique-demo-root [data-boutique-anchor-target],
    #sarahs-boutique-demo-root [data-boutique-panel] {
      scroll-margin-top: 8rem !important;
    }

    #sarahs-boutique-demo-root [data-boutique-category-target] {
      scroll-margin-top: 8.5rem !important;
    }

    @media (width >= 48rem) {
      #sarahs-boutique-demo-root [data-boutique-anchor-target],
      #sarahs-boutique-demo-root [data-boutique-panel] {
        scroll-margin-top: 9rem !important;
      }

      #sarahs-boutique-demo-root [data-boutique-category-target] {
        scroll-margin-top: 9.5rem !important;
      }
    }

    [data-boutique-panel] [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }

    #sarahs-boutique-demo-root [data-boutique-visit-success] {
      display: none !important;
    }

    #visit-confirmation:target {
      display: block !important;
    }
  </style>

  <nav
    class="bg-[var(--sarahs-bg-warm)]/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-40"
  >
    <div
      class="max-w-6xl 3xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 xl:px-10 3xl:px-20 py-4 3xl:py-6 flex flex-col md:flex-row justify-between items-center gap-4 3xl:gap-6"
    >
      <a
        href={`#${homeId}`}
        data-boutique-go-view="home"
        class="font-serif text-lg xl:text-xl 3xl:text-2xl tracking-[0.25em] bg-transparent text-[var(--sarahs-text-ink)] font-bold cursor-pointer hover:opacity-80 decoration-none"
      >
        SARAH'S BOUTIQUE
      </a>

      <div
        class="flex flex-wrap justify-center items-center gap-x-6 3xl:gap-x-10 gap-y-2 text-xs xl:text-sm 3xl:text-base font-semibold uppercase tracking-widest text-[var(--sarahs-text-ink)]"
      >
        <a
          href={`#${homeId}`}
          data-boutique-nav="home"
          class="nav-tab text-[#6B3A2B] hover:text-[#6B3A2B] cursor-pointer decoration-none"
        >
          Home
        </a>
        <a
          href={`#${catalogueId}`}
          data-boutique-nav="catalogue"
          class="nav-tab text-[#6B3A2B] hover:text-[#6B3A2B] cursor-pointer decoration-none"
        >
          Catalogue
        </a>
        <a
          href={`#${aboutId}`}
          data-boutique-nav="about"
          class="nav-tab text-[#6B3A2B] hover:text-[#6B3A2B] cursor-pointer decoration-none"
        >
          About
        </a>
        <a
          href={`#${visitId}`}
          data-boutique-nav="visit"
          class="nav-tab text-[#6B3A2B] hover:text-[#6B3A2B] cursor-pointer decoration-none"
        >
          Visit Store
        </a>
      </div>
    </div>
  </nav>

  <div id={homeId} data-boutique-panel="home" data-boutique-active="true">
    <div
      class="animate-fade-in relative min-h-[calc(100vh-69px)] 3xl:min-h-[calc(100vh-80px)] flex items-center justify-center p-8 xl:p-12 3xl:p-20 bg-black overflow-hidden rounded-none text-center text-white"
    >
      <div class="absolute inset-0 z-0 rounded-none">
        <Image
          src={sarahsBoutiqueHeroImage}
          widths={[480, 960, 1600]}
          sizes="100vw"
          alt="Editorial style soft luxury backdrop"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-skeleton
          class="image-skeleton h-full w-full rounded-none object-cover opacity-60 filter blur-[1px]"
        />
        <div class="absolute inset-0 bg-stone-950/45"></div>
      </div>

      <div
        class="relative z-10 max-w-2xl xl:max-w-3xl 2xl:max-w-4xl 3xl:max-w-5xl text-center text-white space-y-6 3xl:space-y-10 px-4 xl:px-8 3xl:px-12"
      >
        <span
          class="text-[10px] xl:text-xs 3xl:text-sm uppercase font-mono tracking-[0.3em] text-[var(--sarahs-hero-eyebrow-text)] font-bold block animate-slide-in-up text-center"
        >
          MONTPELLIER ARCADE • HARROGATE
        </span>
        <h1
          class="font-serif text-4xl sm:text-6xl xl:text-7xl 2xl:text-8xl 3xl:text-9xl tracking-wide font-black capitalize text-stone-55 select-none animate-fade-in"
        >
          Sarah's Boutique
        </h1>
        <p
          class="font-serif text-lg sm:text-xl xl:text-2xl 2xl:text-3xl 3xl:text-4xl italic text-[var(--sarahs-bg-warm)] leading-relaxed font-light"
        >
          "Soft luxury garments designed under northern winds. Boiled wool, raw silk, and un-dyed
          cashmere knitwear crafted to last."
        </p>
        <div class="w-12 3xl:w-20 h-px 3xl:h-0.5 bg-white/40 mx-auto my-6 3xl:my-10"></div>

        <a
          href={`#${catalogueId}`}
          data-boutique-go-view="catalogue"
          class="bg-white hover:bg-[var(--sarahs-bg-warm)] text-stone-950 font-bold px-8 xl:px-10 3xl:px-14 py-4 xl:py-5 3xl:py-7 rounded-sm text-xs xl:text-sm 3xl:text-lg uppercase tracking-widest transition-all hover-button-polish cursor-pointer shadow-md 3xl:shadow-xl inline-flex items-center gap-2 3xl:gap-3 decoration-none"
        >
          <span>Explore The Catalogue</span>
          <BoutiqueIcon name="ChevronRight" className="w-4 h-4 3xl:w-6 3xl:h-6" />
        </a>
      </div>
    </div>

    <section
      class="bg-[var(--sarahs-bg-warm)] py-16 xl:py-20 3xl:py-28 border-t border-stone-200/60 text-left"
    >
      <div class="max-w-6xl 3xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 xl:px-10 3xl:px-20">
        <h2
          class="font-serif text-2xl md:text-3xl xl:text-4xl 2xl:text-5xl 3xl:text-6xl font-bold tracking-tight mb-8 3xl:mb-12"
          data-reveal="fade"
        >
          Autumn Featured Highlights
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 3xl:gap-12">
          {
            sarahsBoutiqueFeaturedProducts.map((product, index) => (
              <a
                href={`#${getSarahsBoutiqueProductDetailId(product.id)}`}
                data-boutique-select-product={product.id}
                data-reveal="card"
                data-reveal-delay={String(index * 80)}
                class="featured-card bg-white border rounded p-4 xl:p-6 3xl:p-8 shadow-xs 3xl:shadow-sm space-y-3 3xl:space-y-5 cursor-pointer group hover:border-[var(--sarahs-accent-terracotta)] transition-colors hover-card-polish text-left decoration-none"
              >
                <div class="aspect-square rounded overflow-hidden bg-stone-50">
                  <Image
                    src={product.image}
                    widths={[320, 560, 760]}
                    sizes="(min-width: 48rem) 20rem, 100vw"
                    alt={product.name}
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                    data-skeleton
                    class="image-skeleton w-full h-full object-cover group-hover:scale-102 transition-transform duration-200"
                  />
                </div>
                <div>
                  <h3 class="font-serif font-black text-sm xl:text-lg 3xl:text-2xl text-stone-900">
                    {product.name}
                  </h3>
                  <p class="text-xs xl:text-sm 3xl:text-lg text-[#8A4A35] font-mono mt-0.5 3xl:mt-1.5">
                    {product.price}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <div id={catalogueId} data-boutique-panel="catalogue">
    <div
      class="animate-fade-in max-w-6xl 3xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 xl:px-10 3xl:px-20 py-12 xl:py-16 3xl:py-24 text-left"
    >
      <div
        class="border-b border-stone-200 pb-8 3xl:pb-12 mb-8 3xl:mb-12 flex flex-col md:flex-row md:justify-between md:items-end gap-6 3xl:gap-10"
        data-reveal="fade"
      >
        <div class="space-y-1.5 3xl:space-y-3">
          <span
            class="text-[10px] xl:text-xs 3xl:text-sm uppercase font-mono text-[var(--sarahs-accent-terracotta)] tracking-widest font-black block"
            >Active Collection</span
          >
          <h1
            class="font-serif text-3xl md:text-4xl xl:text-5xl 2xl:text-6xl 3xl:text-7xl font-extrabold text-[var(--sarahs-text-ink)]"
          >
            The Boutique Inventory
          </h1>
          <p
            class="text-xs xl:text-sm 3xl:text-lg text-stone-500 max-w-xl 3xl:max-w-2xl font-serif italic"
          >
            Sourced from family-run mills, selected by hand, and crafted for physical longevity.
            Limited seasonal drop sizes now on key display racks.
          </p>
        </div>

        <div
          class="bg-[var(--sarahs-card-line-bg)] border border-stone-300 p-4 xl:p-6 3xl:p-8 rounded max-w-sm 3xl:max-w-md flex gap-3 3xl:gap-5 text-left hover-card-polish"
          data-reveal="scale"
          data-reveal-delay="120"
        >
          <BoutiqueIcon
            name="Sparkles"
            className="w-5 h-5 3xl:w-8 3xl:h-8 text-[var(--sarahs-accent-terracotta)] shrink-0"
          />
          <div class="space-y-0.5 3xl:space-y-1.5">
            <p class="text-xs xl:text-sm 3xl:text-lg font-bold text-stone-800">
              Autumn Drop II Arrived
            </p>
            <p class="text-[10px] xl:text-xs 3xl:text-base text-stone-500 leading-normal">
              Curated coat arrangements and double wool blends are now available for exclusive store
              fitting appointment locks.
            </p>
          </div>
        </div>
      </div>

      <div
        class="flex flex-wrap gap-2.5 3xl:gap-4 mb-8 3xl:mb-12 border-b border-stone-200/50 pb-5 3xl:pb-8"
        data-reveal="fade"
      >
        <div aria-hidden="true">
          {
            sarahsBoutiqueCategories.map((category) => (
              <span
                id={getSarahsBoutiqueCategoryAnchorId(category)}
                data-boutique-anchor-target
                data-boutique-category-target
                class="block h-0 overflow-hidden"
              />
            ))
          }
        </div>
        {
          sarahsBoutiqueCategories.map((category) => (
            <>
              <span class="sr-only">
                <a href={`#${getSarahsBoutiqueCategoryAnchorId(category)}`}>
                  Filter products by {category}
                </a>
              </span>
              <a
                href={`#${getSarahsBoutiqueCategoryAnchorId(category)}`}
                data-boutique-filter={category}
