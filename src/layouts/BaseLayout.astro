---
import '../index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteMeta } from '../data/site';

const {
  title = siteMeta.title,
  description = siteMeta.description,
  image = siteMeta.socialImage,
  noindex = false,
  includeBusinessSchema = true,
} = Astro.props;

const siteUrl = Astro.site ?? siteMeta.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
const socialImageAlt = `${siteMeta.name} brand identity`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: siteMeta.name,
  description: siteMeta.description,
  inLanguage: 'en-GB',
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}#business`,
  name: siteMeta.name,
  image: new URL(siteMeta.socialImage, siteUrl).href,
  logo: new URL(siteMeta.socialImage, siteUrl).href,
  url: siteUrl,
  description:
    'Complete, done-for-you websites for local UK businesses. We handle the design, secure UK hosting, setup, and updates under a flat monthly payment.',
  email: siteMeta.email,
  priceRange: siteMeta.priceRange,
  areaServed: siteMeta.areaServed,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteMeta.locality,
    addressCountry: 'GB',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: siteMeta.email,
      areaServed: siteMeta.areaServed,
      availableLanguage: ['en-GB'],
    },
  ],
};

const structuredData = [
  !noindex ? websiteSchema : null,
  includeBusinessSchema ? businessSchema : null,
].filter(Boolean);
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#006D77" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content={siteMeta.name} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <noscript>
      <link rel="stylesheet" href="/noscript.css" />
    </noscript>

    {structuredData.map((schema, index) => <script type="application/ld+json" set:html={JSON.stringify(schema)} data-schema={index} />)}
  </head>
  <body class="bg-white">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="min-h-screen text-slate-800 antialiased text-left flex flex-col justify-between">
      <div>
        <Header />
        <main id="main-content">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <script>
      import initSite from '../scripts/site';

      initSite();
    </script>
  </body>
</html>
