---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legalTabContent, legalTabs } from '../../content/legalContent';
---

<BaseLayout
  title="Legal | Septen"
  description="Terms, privacy, cookie policy, data rights, and disclaimer information for Septen."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-left">
    <div class="max-w-4xl space-y-6">
      <div class="space-y-2">
        <p class="text-xs font-black uppercase tracking-widest text-brand-teal">Legal Information</p>
        <h1 class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight">Terms, Privacy, and Data Rights</h1>
        <p class="max-w-3xl text-sm md:text-base leading-relaxed text-slate-600">
          These documents remain available without JavaScript so the site's key legal information stays reachable in every browsing mode.
        </p>
      </div>

      <nav aria-label="Legal document navigation" class="flex flex-wrap gap-3 border-t border-slate-200 pt-6">
        {legalTabs.map((tab) => (
          <a
            href={`#${tab.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-xs font-extrabold uppercase tracking-widest text-slate-600 transition-colors hover:border-brand-teal hover:text-brand-teal"
          >
            {tab.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 text-left">
    <div class="space-y-6">
      {legalTabs.map((tab) => (
        <section id={tab.id} class="section-scroll-target rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
          <div class="legal-copy-content legal-copy-static space-y-3 text-[13px] leading-relaxed text-slate-700" set:html={legalTabContent[tab.id]} />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
