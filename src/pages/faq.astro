---
import BaseLayout from "@components/layout/BaseLayout.astro";
import { faqItems } from "@data/site";
import FaqItem from "@components/ui/FaqItem.astro";
---

<BaseLayout
  title="FAQ & Contact | Septen"
  description="Find answers to frequently asked questions about Septen's custom web design, secure UK hosting, and total management services, or contact our team directly."
>
  <h1 class="sr-only">Frequently Asked Questions & Contact — Septen Custom Web Design</h1>
  <!-- ============================================================
       FAQ SECTION
       Collapsible FAQ accordion items
       ============================================================ -->
  <section
    id="faq"
    class="w-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-14 2xl:px-20 pt-8 sm:pt-10 md:pt-12 xl:pt-16 pb-8 sm:pb-10 md:pb-12 xl:pb-16 text-center flex flex-col items-center justify-center min-h-0 shrink-0"
    aria-labelledby="faq-title"
  >
    <div
      class="max-w-2xl xl:max-w-3xl 2xl:max-w-4xl mx-auto mb-6 sm:mb-8 md:mb-10 xl:mb-12 text-center shrink-0"
    >
      <h2 id="faq-title" data-reveal class="demos-hero-title">Frequently Asked Questions</h2>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-x-6 md:gap-x-8 xl:gap-x-10 gap-y-4 sm:gap-y-5 md:gap-y-6 xl:gap-y-7 max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto text-left items-start w-full"
    >
      {
        faqItems.map((item, index) => (
          <FaqItem
            question={item.question}
            answer={item.answer}
            revealDelay={String(index * 45)}
            revealType={index % 3 === 1 ? "card" : index % 3 === 2 ? "scale" : "fade"}
          />
        ))
      }
    </div>
  </section>

  <!-- ============================================================
       CONTACT SECTION
       Enquiry CTA with no-JS email fallback
       ============================================================ -->
  <section
    id="contact"
    class="w-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-14 2xl:px-20 py-10 sm:py-12 md:py-16 xl:py-20 text-center animate-fade-in border-t border-slate-200 mt-6 sm:mt-8 md:mt-10 xl:mt-12 flex items-center justify-center min-h-0 shrink-0"
    aria-labelledby="contact-title"
  >
    <div
      class="max-w-2xl xl:max-w-3xl 2xl:max-w-4xl mx-auto space-y-5 sm:space-y-6 md:space-y-8 xl:space-y-10 w-full flex flex-col items-center justify-center min-h-0"
    >
      <div class="shrink-0">
        <h2
          id="contact-title"
          data-reveal
          class="font-sans text-base sm:text-lg md:text-xl xl:text-3xl 2xl:text-4xl font-extrabold text-brand-teal tracking-tight leading-tight"
        >
          Ready to transform your business presence?
        </h2>
      </div>
      <p
        data-reveal="fade"
        data-reveal-delay="70"
        class="text-sm sm:text-base md:text-lg text-slate-600 max-w-lg xl:max-w-2xl 2xl:max-w-3xl mx-auto leading-relaxed shrink-0"
      >
        We handle design, secure local UK hosting, and total management. Get in touch to discuss
        your goals with our friendly team.
      </p>

      <div data-reveal="fade" data-reveal-delay="130" class="pt-0.5 sm:pt-1 xl:pt-2 shrink-0">
        <button
          type="button"
          data-open-enquiry
          aria-label="Begin the online enquiry form"
          class="bg-brand-teal hover:bg-brand-teal-dark text-white font-bold text-sm sm:text-base md:text-lg px-5 sm:px-6 md:px-7 xl:px-8 py-3 sm:py-3.5 md:py-4 rounded-xl transition-all shadow-brand-teal cursor-pointer border-none uppercase tracking-widest font-mono inline-flex items-center gap-2 sm:gap-2.5 md:gap-3 mx-auto hover-button-polish decoration-none"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3 h-3 sm:w-3.5 sm:h-3.5 md:w-4 md:h-4 xl:w-6 xl:h-6 text-white animate-pulse"
          >
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Ask us a question</span>
        </button>
      </div>

      <noscript>
        <p
          class="text-[0.8125rem] sm:text-[0.875rem] md:text-sm xl:text-base text-slate-500 leading-relaxed shrink-0"
        >
          JavaScript is disabled. Email{" "}
          <strong class="font-bold text-brand-teal select-all">septen.digital@gmail.com</strong>{
            " "
          }
          to enquire directly.
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  const faqStorageKey = "septen:faq-open-items";
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-faq-item]"));
  let savedFaqValues: unknown = [];
  try {
    savedFaqValues = JSON.parse(localStorage.getItem(faqStorageKey) ?? "[]");
  } catch {
    savedFaqValues = [];
  }
  const savedFaqItems = new Set(Array.isArray(savedFaqValues) ? savedFaqValues : []);

  faqItems.forEach((item) => {
    const key = item.dataset.faqKey;
    if (key && savedFaqItems.has(key)) item.open = true;
    item.addEventListener("toggle", () => {
      if (!key) return;
      if (item.open) savedFaqItems.add(key);
      else savedFaqItems.delete(key);
      try {
        localStorage.setItem(faqStorageKey, JSON.stringify([...savedFaqItems]));
      } catch {}
    });
  });
</script>
