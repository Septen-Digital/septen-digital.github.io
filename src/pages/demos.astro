---
import BaseLayout from "@components/layout/BaseLayout.astro";
import DemoPreview from "@demos/shared/DemoPreview.astro";
import { demoCards } from "@data/site";
---

<BaseLayout
  title="Demos | Septen"
  description="Browse interactive demo websites showcasing custom web design quality and total management features for trades, hospitality, retail, fitness, and professional service local businesses."
>
  <h1 class="sr-only">Interactive Demo Websites — Septen Custom Web Design for Local Businesses</h1>
  <!-- ============================================================
      DEMOS SECTION
       5 interactive demo preview cards
       ============================================================ -->
  <section
    id="demos"
    class="w-full h-full mx-auto px-5 sm:px-6 lg:px-8 xl:px-14 2xl:px-20 3xl:px-12 4xl:px-16 pt-12 sm:pt-12 md:pt-16 xl:pt-20 pb-12 sm:pb-12 md:pb-16 xl:pb-20 3xl:pb-24 4xl:pb-28 text-center flex flex-col items-center justify-center min-h-0 shrink-0"
    aria-labelledby="demos-title"
  >
    <div
      class="flex flex-col items-center justify-center gap-8 sm:gap-8 md:gap-10 xl:gap-12 3xl:gap-16 4xl:gap-20 h-full w-full min-h-0"
    >
      <div
        data-reveal="fade"
        class="text-center shrink-0 max-w-2xl xl:max-w-4xl 2xl:max-w-5xl 3xl:max-w-6xl 4xl:max-w-7xl mx-auto"
      >
        <h2 id="demos-title" class="demos-hero-title">See Demos</h2>
        <p
          class="text-[0.875rem] sm:text-sm md:text-base xl:text-lg 2xl:text-xl 3xl:text-2xl 4xl:text-3xl text-stone-500 leading-relaxed mt-2 sm:mt-3 md:mt-4 xl:mt-5 3xl:mt-6 max-w-xl xl:max-w-3xl 2xl:max-w-4xl 3xl:max-w-5xl mx-auto"
        >
          Choose any design layout below to test physical interaction, diagnostic inputs, scheduling
          calendars, or menu features live.
        </p>
      </div>

      <div
        class="flex flex-wrap 3xl:grid 3xl:grid-cols-5 justify-center gap-5 sm:gap-5 md:gap-6 xl:gap-7 2xl:gap-8 3xl:gap-10 4xl:gap-12 w-full items-stretch content-center max-w-7xl xl:max-w-[95rem] 2xl:max-w-[110rem] 3xl:max-w-[145rem] 4xl:max-w-[180rem] mx-auto flex-1 min-h-0"
      >
        {
          demoCards.map((demo, index) => (
            <article
              id={`demo-${demo.slug}`}
              data-reveal="showcase"
              data-reveal-delay={String(index * 70)}
              class="demo-card-return-target shrink-0 grow-0 w-full sm:w-[calc(50%-0.75rem)] md:w-[calc(33.333%-1rem)] 3xl:w-full min-w-0 max-w-[22rem] 3xl:max-w-none border border-slate-200 rounded-md sm:rounded-lg md:rounded-xl p-4 sm:p-5 md:p-5 xl:p-6 2xl:p-7 3xl:p-8 4xl:p-9 flex flex-col justify-between items-center hover:border-slate-300 transition-colors text-center bg-white shadow-xs hover-card-polish min-h-0"
            >
              <div class="space-y-3 sm:space-y-3 md:space-y-4 xl:space-y-5 2xl:space-y-6 3xl:space-y-7 w-full flex flex-col items-center min-h-0">
                <h3 class="font-sans text-[0.875rem] sm:text-sm md:text-base xl:text-xl 2xl:text-2xl 3xl:text-xl 4xl:text-2xl font-extrabold text-brand-teal text-center leading-snug">
                  {demo.name}
                </h3>
                <p class="text-[0.8125rem] sm:text-[0.875rem] md:text-sm xl:text-base 2xl:text-lg 3xl:text-base text-slate-600 leading-relaxed text-center max-w-xs 3xl:max-w-sm mx-auto">
                  {demo.description}
                </p>

                <div
                  data-reveal="panel"
                  data-reveal-delay={String(90 + index * 70)}
                  class="border border-slate-200 rounded-md sm:rounded-md md:rounded-lg overflow-hidden select-none bg-stone-50 text-[0.4375rem] sm:text-[0.5rem] md:text-[0.5625rem] xl:text-[0.625rem] 2xl:text-xs 3xl:text-sm font-mono shadow-xs w-full max-w-[170px] sm:max-w-[190px] md:max-w-[220px] xl:max-w-[260px] 2xl:max-w-[300px] 3xl:max-w-none mx-auto min-h-0 shrink-0"
                >
                  <div class="bg-slate-200/40 p-0.5 sm:p-1 md:p-1.5 flex gap-0.5 sm:gap-1 items-center border-b border-slate-200/30">
                    <div class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-slate-300" />
                    <div class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-slate-300" />
                    <div class="bg-white grow text-center text-[0.375rem] sm:text-[0.5rem] md:text-[0.5625rem] xl:text-[0.625rem] text-slate-400 py-0.5 rounded px-1 sm:px-1.5 text-ellipsis overflow-hidden whitespace-nowrap">
                      {demo.siteLabel}
                    </div>
                  </div>
                  <DemoPreview slug={demo.slug} />
                </div>
              </div>

              <a
                href={`/demos/${demo.slug}/`}
                aria-label={`Open the demo website for ${demo.name}`}
                class="w-full bg-brand-teal hover:bg-brand-teal-dark text-white text-[0.8125rem] sm:text-sm md:text-base xl:text-base 2xl:text-lg 3xl:text-lg font-extrabold py-2.5 sm:py-2.5 md:py-3 xl:py-3.5 2xl:py-4 3xl:py-3.5 rounded-md sm:rounded-md md:rounded-lg border-none mt-3 sm:mt-4 md:mt-5 xl:mt-6 2xl:mt-7 3xl:mt-6 cursor-pointer text-center hover-button-polish decoration-none shrink-0 min-h-[3rem] md:min-h-0"
              >
                See Demo Website
              </a>
            </article>
          ))
        }
      </div>

      <p
        data-reveal="fade"
        data-reveal-delay="160"
        class="text-[0.875rem] sm:text-[0.875rem] md:text-sm xl:text-base 2xl:text-lg 3xl:text-xl text-slate-500 max-w-3xl xl:max-w-4xl 3xl:max-w-5xl mx-auto leading-relaxed shrink-0 mt-4 sm:mt-5 md:mt-6 xl:mt-8 3xl:mt-10"
      >
        Demo websites are illustrative preview builds for exploring layout, motion, and interaction
        ideas before a live client project is commissioned.
      </p>
    </div>
  </section>
</BaseLayout>
