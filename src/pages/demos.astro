---
import BaseLayout from "@components/layout/BaseLayout.astro";
import DemoPreview from "@demos/shared/DemoPreview.astro";
import { demoCards } from "@data/site";
---

<BaseLayout
  title="Demos | Septen"
  description="Browse interactive demo websites showcasing custom web design quality and total management features for trades, hospitality, retail, fitness, and professional service local businesses."
>
  <h1 class="sr-only">Interactive Demo Websites — Septen Custom Web Design for Local Businesses</h1>
  <!-- ============================================================
      DEMOS SECTION
       5 interactive demo preview cards
       ============================================================ -->
  <section
    id="demos"
    class="w-full h-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-14 2xl:px-20 3xl:px-12 4xl:px-16 pt-8 sm:pt-10 md:pt-12 xl:pt-16 pb-8 sm:pb-10 md:pb-12 xl:pb-16 3xl:pb-16 4xl:pb-20 text-center flex flex-col items-center justify-center min-h-0 shrink-0"
    aria-labelledby="demos-title"
  >
    <div
      class="flex flex-col items-center justify-center gap-5 sm:gap-6 md:gap-7 xl:gap-8 3xl:gap-16 4xl:gap-20 h-full w-full min-h-0"
    >
      <div
        data-reveal="fade"
        class="text-center shrink-0 max-w-2xl xl:max-w-4xl 2xl:max-w-5xl 3xl:max-w-6xl 4xl:max-w-7xl mx-auto"
      >
        <h2 id="demos-title" class="demos-hero-title">See Demos</h2>
        <p
          class="text-[10px] sm:text-xs md:text-sm xl:text-lg 2xl:text-xl 3xl:text-2xl 4xl:text-3xl text-stone-500 leading-snug mt-0.5 sm:mt-1 md:mt-2 xl:mt-3 3xl:mt-4 max-w-xl xl:max-w-3xl 2xl:max-w-4xl 3xl:max-w-5xl mx-auto"
        >
          Choose any design layout below to test physical interaction, diagnostic inputs, scheduling
          calendars, or menu features live.
        </p>
      </div>

      <div
        class="flex flex-wrap 3xl:grid 3xl:grid-cols-5 justify-center gap-3 sm:gap-3.5 md:gap-4 xl:gap-5 2xl:gap-6 3xl:gap-8 4xl:gap-10 w-full items-stretch content-center max-w-7xl xl:max-w-[95rem] 2xl:max-w-[110rem] 3xl:max-w-[145rem] 4xl:max-w-[180rem] mx-auto flex-1 min-h-0"
      >
        {
          demoCards.map((demo, index) => (
            <article
              id={`demo-${demo.slug}`}
              data-reveal="showcase"
              data-reveal-delay={String(index * 70)}
              class="demo-card-return-target shrink-0 grow-0 w-full sm:w-[calc(50%-0.75rem)] md:w-[calc(33.333%-1rem)] 3xl:w-full min-w-0 max-w-[18rem] 3xl:max-w-none border border-slate-200 rounded-md sm:rounded-lg md:rounded-xl p-1.5 sm:p-2 md:p-2.5 xl:p-3 2xl:p-4 3xl:p-5 4xl:p-6 flex flex-col justify-between items-center hover:border-slate-300 transition-colors text-center bg-white shadow-xs hover-card-polish min-h-0"
            >
              <div class="space-y-1 sm:space-y-1.5 md:space-y-2 xl:space-y-2.5 2xl:space-y-3 3xl:space-y-4 w-full flex flex-col items-center min-h-0">
                <h3 class="font-sans text-[10px] sm:text-[11px] md:text-xs xl:text-base 2xl:text-lg 3xl:text-base 4xl:text-lg font-bold text-brand-teal text-center leading-tight">
                  {demo.name}
                </h3>
                <p class="text-[8px] sm:text-[9px] md:text-[11px] xl:text-xs 2xl:text-sm 3xl:text-xs text-slate-600 leading-snug text-center max-w-xs 3xl:max-w-sm mx-auto">
                  {demo.description}
                </p>

                <div
                  data-reveal="panel"
                  data-reveal-delay={String(90 + index * 70)}
                  class="border border-slate-200 rounded-md sm:rounded-md md:rounded-lg overflow-hidden select-none bg-stone-50 text-[0.375rem] sm:text-[0.4375rem] md:text-[0.5rem] xl:text-[0.5625rem] 2xl:text-xs 3xl:text-sm font-mono shadow-xs w-full max-w-[160px] sm:max-w-[180px] md:max-w-[200px] xl:max-w-[240px] 2xl:max-w-[280px] 3xl:max-w-none mx-auto min-h-0 shrink-0"
                >
                  <div class="bg-slate-200/40 p-0.5 sm:p-1 md:p-1.5 flex gap-0.5 sm:gap-1 items-center border-b border-slate-200/30">
                    <div class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-slate-300" />
                    <div class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-slate-300" />
                    <div class="bg-white grow text-center text-[0.3125rem] sm:text-[0.4375rem] md:text-[0.5rem] xl:text-[0.5625rem] text-slate-400 py-0.5 rounded px-1 sm:px-1.5 text-ellipsis overflow-hidden whitespace-nowrap">
                      {demo.siteLabel}
                    </div>
                  </div>
                  <DemoPreview slug={demo.slug} />
                </div>
              </div>

              <a
                href={`/demos/${demo.slug}/`}
                aria-label={`Open the demo website for ${demo.name}`}
                class="w-full bg-brand-teal hover:bg-brand-teal-dark text-white text-[9px] sm:text-[10px] md:text-xs xl:text-sm 2xl:text-base 3xl:text-sm font-bold py-1 sm:py-1.5 md:py-2 xl:py-2.5 2xl:py-3 3xl:py-2.5 rounded-md sm:rounded-md md:rounded-lg border-none mt-1.5 sm:mt-2 md:mt-2.5 xl:mt-3 2xl:mt-4 3xl:mt-3 cursor-pointer text-center hover-button-polish decoration-none shrink-0"
              >
                See Demo Website
              </a>
            </article>
          ))
        }
      </div>

      <p
        data-reveal="fade"
        data-reveal-delay="160"
        class="text-[9px] sm:text-[10px] md:text-xs xl:text-base 2xl:text-lg 3xl:text-lg text-slate-500 max-w-3xl xl:max-w-4xl 3xl:max-w-5xl mx-auto leading-snug shrink-0 mt-1 sm:mt-2 xl:mt-4 3xl:mt-2"
      >
        Demo websites are illustrative preview builds for exploring layout, motion, and interaction
        ideas before a live client project is commissioned.
      </p>
    </div>
  </section>
</BaseLayout>
