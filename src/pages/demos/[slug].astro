---
import BaseLayout from "@layouts/BaseLayout.astro";
import { demoRegistry, demoSlugs, getDemoMarkup } from "@demos/scripts/demoMarkup";
import { getImage, Image } from "astro:assets";
import SarahsBoutiqueDemo from "@demos/sarahs-boutique/SarahsBoutiqueDemo.astro";
import { getDemoSsrImageConfig, getDemoHeroRawImage } from "@demos/shared/ssrImageConfig";

function buildImageAttrs(
  src: string,
  srcset: string,
  sizes: string,
  layout: "constrained" | "full-width",
  alt: string,
  loading: "eager" | "lazy",
  fetchpriority: "high" | "low" | "auto",
  className: string,
  width?: number,
  height?: number,
): string {
  const dimensions = [
    typeof width === "number" ? `width="${width}"` : "",
    typeof height === "number" ? `height="${height}"` : "",
    `data-astro-image="${layout}"`,
  ]
    .filter(Boolean)
    .join(" ");

  return [
    "<" + "img",
    dimensions,
    `src="${src}"`,
    `srcset="${srcset}"`,
    `sizes="${sizes}"`,
    `alt="${alt}"`,
    `loading="${loading}"`,
    `fetchpriority="${fetchpriority}"`,
    `decoding="async"`,
    `data-skeleton`,
    `class="${className}"`,
    `/>`,
  ]
    .filter(Boolean)
    .join(" ");
}

async function getOptimizedDemoMarkup(
  slug: string,
  tokensToSkip: string[] = [],
): Promise<string> {
  // The legacy demos still produce HTML strings. This SSR pass swaps their
  // placeholder image tokens for optimized Astro image output before shipping
  // the final HTML to the browser.
  let markup = getDemoMarkup(slug);
  const imageConfig = getDemoSsrImageConfig(slug);
  const skipTokens = new Set(tokensToSkip);

  for (const config of imageConfig) {
    if (skipTokens.has(config.sourceToken)) {
      continue;
    }

    const optimizedImage = await getImage({
      src: config.image,
      width: config.width,
      widths: [...config.widths, config.width],
      sizes: config.sizes,
      format: "webp",
      quality: "mid",
    });

    const optimizedAttrs = buildImageAttrs(
      optimizedImage.src,
      optimizedImage.srcSet.attribute,
      config.sizes,
      config.layout,
      config.alt,
      config.loading,
      config.fetchpriority,
      config.className,
      Number(optimizedImage.attributes.width),
      Number(optimizedImage.attributes.height),
    );

    markup = markup.replace(config.sourceToken, optimizedAttrs);
  }

  return markup;
}

export function getStaticPaths() {
  return demoSlugs.map((slug) => ({
    params: { slug },
    props: { slug, demo: demoRegistry[slug] },
  }));
}

const { slug, demo } = Astro.props;
const isSarahsBoutiqueDemo = slug === "sarahs-boutique";
const visibleHeroToken =
  slug === "north-shore-fitness"
    ? "__NORTH_SHORE_HERO_IMAGE__"
    : slug === "alder-and-pipe-plumbing"
      ? "__PETERS_HERO_IMAGE__"
      : null;
const demoImageConfig = isSarahsBoutiqueDemo ? [] : getDemoSsrImageConfig(slug);
const visibleHeroConfig =
  visibleHeroToken === null
    ? null
    : demoImageConfig.find((config) => config.sourceToken === visibleHeroToken) ??
      null;
const visibleHeroImage = getDemoHeroRawImage(slug);
// When a legacy demo has an above-the-fold hero image, we split the string
// markup around that token and render the hero with Astro directly. That keeps
// the hero image discoverable without rewriting the whole demo component.
const markup = isSarahsBoutiqueDemo
  ? ""
  : await getOptimizedDemoMarkup(
      slug,
      visibleHeroConfig ? [visibleHeroConfig.sourceToken] : [],
    );
const visibleHeroMarkupParts =
  visibleHeroConfig && markup.includes(visibleHeroConfig.sourceToken)
    ? markup.split(visibleHeroConfig.sourceToken)
    : null;
---

<BaseLayout
  title={`${demo.title} | Septen`}
  description={demo.description}
  noindex={true}
  includeBusinessSchema={false}
>
  <div data-demo-page>
    <div
      class="demo-sticky-offset sticky z-50 border-b border-slate-200 bg-white"
    >
      <div
        class="max-w-7xl mx-auto flex justify-center px-4 py-2.5 sm:px-6 md:py-4 lg:px-8"
      >
        <a
          href={`/#demo-${slug}`}
          class="inline-flex min-w-[15rem] items-center justify-center rounded-lg border border-brand-teal bg-white px-6 py-2 text-xs font-bold text-brand-teal shadow-sm transition-colors hover:bg-brand-teal hover:text-white md:min-w-[24rem] md:px-10 md:py-4 md:text-[0.95rem] md:shadow-[0_10px_28px_rgba(15,23,42,0.08)] lg:min-w-[26rem]"
        >
          Back to Septen
        </a>
      </div>
    </div>

    <section class="border-b border-slate-200 bg-white text-left">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="space-y-2">
          <p
            class="text-xs font-black uppercase tracking-widest text-brand-teal"
          >
            Interactive Demo
          </p>
          <p
            class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight"
          >
            {demo.title}
          </p>
          <p
            class="text-sm md:text-base text-slate-600 max-w-3xl leading-relaxed"
          >
            This sample website is a Septen concept demo built to preview
            layout, interaction patterns, and overall feel before a live project
            goes ahead.
          </p>
        </div>
      </div>
    </section>

    <noscript>
      <!-- These demos remain readable without JS, but we set expectations that
           form submissions and enhanced controls are limited in no-script mode. -->
      <section class="border-b border-slate-200 bg-stone-50 text-left">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
          <p class="text-sm leading-relaxed text-slate-600">
            JavaScript is disabled. These concept demos remain viewable, but
            interactive controls and forms may be limited. Return to Septen to
            enquire directly, or email{" "}
            <strong class="font-bold text-brand-teal select-all"
              >septen.digital@gmail.com</strong
            >.
          </p>
        </div>
      </section>
    </noscript>

    <button
      type="button"
      data-demo-back-to-top
      class="pointer-events-none fixed bottom-5 right-4 z-40 inline-flex h-10 w-10 translate-y-2 items-center justify-center rounded-full border border-brand-teal/25 bg-white/96 text-brand-teal opacity-0 shadow-[0_12px_32px_rgba(2,8,23,0.16)] backdrop-blur-sm transition-[opacity,background-color,border-color,color,box-shadow] duration-300 hover:border-brand-teal hover:bg-brand-teal hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-teal/30 will-change-transform sm:bottom-7 sm:right-7 md:bottom-12 md:right-14 md:h-16 md:min-w-[5.75rem] md:gap-2 md:rounded-full md:border-2 md:px-4 md:shadow-[0_18px_48px_rgba(2,8,23,0.2)] lg:right-[4.5rem] cursor-pointer"
      aria-label="Back to top"
      aria-hidden="true"
    >
      <span
        class="absolute inset-0 hidden rounded-full border border-brand-teal/20 md:block md:scale-[1.08] md:animate-pulse motion-reduce:animate-none"
        aria-hidden="true"></span>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 md:h-6 md:w-6 md:shrink-0"
      >
        <path d="M12 19V5"></path>
        <path d="m6 11 6-6 6 6"></path>
      </svg>
      <span
        class="hidden text-[0.6875rem] font-black uppercase tracking-[0.22em] md:inline"
        >Top</span
      >
    </button>

    {
      isSarahsBoutiqueDemo ? (
        <SarahsBoutiqueDemo />
      ) : visibleHeroConfig && visibleHeroImage && visibleHeroMarkupParts ? (
        <>
          <div data-demo-root data-demo-slug={slug}>
            <Fragment set:html={visibleHeroMarkupParts[0] ?? ""} />
            <Image
              src={visibleHeroImage}
              widths={[...visibleHeroConfig.widths, visibleHeroConfig.width]}
              sizes={visibleHeroConfig.sizes}
              alt={visibleHeroConfig.alt}
              loading={visibleHeroConfig.loading}
              fetchpriority={visibleHeroConfig.fetchpriority}
              decoding="async"
              data-skeleton
              class={visibleHeroConfig.className}
            />
            <Fragment set:html={visibleHeroMarkupParts[1] ?? ""} />
          </div>

          <script>
            import initDemoPage from '@demos/scripts/demoPage'; initDemoPage();
          </script>
        </>
      ) : (
        <>
          <div data-demo-root data-demo-slug={slug} set:html={markup} />

          <script>
            import initDemoPage from '@demos/scripts/demoPage'; initDemoPage();
          </script>
        </>
      )
    }
  </div>
</BaseLayout>
