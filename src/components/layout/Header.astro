---
import { Image } from "astro:assets";
import logo from "@assets/logo.svg";

/**
 * TEMPORARY TOGGLE (for full-page screenshots):
 * ------------------------------------------------
 *  - HEADER_STICKY_ENABLED = false → header scrolls away with page content
 *    (useful when taking a single full-document screenshot with no sticky
 *    chrome blocking the top sections)
 *  - HEADER_STICKY_ENABLED = true  → header is sticky at the viewport top
 *    as designed for the live site (the normal production default).
 */
const HEADER_STICKY_ENABLED = true;
const stickyClasses = HEADER_STICKY_ENABLED ? "sticky top-0 z-50" : "relative z-20";

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: "/pricing", label: "Services" },
  { href: "/demos", label: "See Demos" },
  { href: "/faq", label: "FAQ" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => {
  const clean = href.replace(/\/$/, "");
  const path = currentPath.replace(/\/$/, "");
  if (clean === "") return path === "";
  return path === clean || path.startsWith(`${clean}/`);
};
---

<header
  class={`${stickyClasses} border-b border-slate-200 bg-white`}
  data-mobile-menu-root
  data-site-header
>
  <div
    class="flex justify-between items-center gap-3 md:gap-4 xl:gap-7 2xl:gap-9 py-3 md:py-4 xl:py-5 pl-[4vw] lg:pl-[5vw] xl:pl-[6vw] 2xl:pl-[8vw] pr-4 sm:pr-6 lg:pr-8 xl:pr-14 2xl:pr-20"
  >
    <a
      href="/"
      aria-label="Septen home page"
      class="site-logo-link flex items-center gap-2.5 xl:gap-3 font-sans font-extrabold text-xl md:text-2xl xl:text-2xl 2xl:text-3xl text-brand-teal tracking-tight leading-none"
    >
      <Image
        src={logo}
        alt="Septen logo"
        width={28}
        height={28}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="site-logo-mark h-7 w-7 md:h-8 md:w-8 xl:h-9 xl:w-9 2xl:h-10 2xl:w-10 shrink-0 object-contain"
      />
      <span>Sep<span class="logo-text-sweep text-brand-orange">ten</span></span>
    </a>

    <details class="md:hidden relative" data-mobile-menu data-state="closed">
      <summary
        class="mobile-menu-toggle inline-flex list-none items-center justify-center rounded-lg border border-slate-200 bg-white p-2.5 text-slate-800 shadow-sm transition-colors duration-200 hover:border-brand-orange hover:text-brand-orange"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-navigation"
        data-mobile-menu-toggle
      >
        <span class="sr-only">Toggle navigation menu</span>
        <span class="relative block h-4 w-4" aria-hidden="true">
          <span
            class="absolute left-0 top-0 block h-0.5 w-4 rounded-full bg-current"
            data-mobile-menu-line="top"></span>
          <span
            class="absolute left-0 top-1/2 block h-0.5 w-4 -translate-y-1/2 rounded-full bg-current"
            data-mobile-menu-line="middle"></span>
          <span
            class="absolute bottom-0 left-0 block h-0.5 w-4 rounded-full bg-current"
            data-mobile-menu-line="bottom"></span>
        </span>
      </summary>
      <div
        id="mobile-navigation"
        class="fixed inset-x-0 top-[var(--site-header-height)] z-40"
        data-mobile-menu-panel
      >
        <div class="border-b border-slate-200 bg-white shadow-xl ring-1 ring-slate-950/5">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4 pt-3">
            <nav
              aria-label="Mobile navigation"
              tabindex="-1"
              class="overflow-hidden rounded-xl border border-slate-200 bg-white p-3.5"
              data-mobile-menu-panel-inner
            >
              <ul class="m-0 list-none space-y-1.5 p-0 text-sm font-bold text-slate-800">
                {
                  navLinks.map(({ href, label }) => (
                    <li>
                      <a
                        href={href}
                        aria-current={isActive(href) ? "page" : undefined}
                        class:list={[
                          "flex items-center justify-between rounded-lg px-3 py-2.5 decoration-none transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2 cursor-pointer",
                          isActive(href)
                            ? "bg-slate-50 text-brand-orange"
                            : "text-slate-800 hover:bg-slate-50 hover:text-brand-orange",
                        ]}
                      >
                        <span>{label}</span>
                      </a>
                    </li>
                  ))
                }
                <li class="pt-1.5">
                  <a
                    href="/faq#contact"
                    data-open-enquiry-mobile
                    aria-label="Contact"
                    class="block w-full rounded-lg border border-brand-orange px-3 py-2.5 text-left text-sm font-bold text-brand-orange transition-colors duration-200 hover:bg-brand-orange hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2 decoration-none bg-transparent cursor-pointer"
                  >
                    Contact
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </details>

    <nav aria-label="Main navigation" class="hidden md:block">
      <ul
        class="flex items-center gap-6 xl:gap-8 2xl:gap-10 text-sm md:text-base xl:text-lg 2xl:text-xl font-bold text-slate-800 list-none p-0 m-0"
      >
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "transition-colors leading-none decoration-none hover-underline-brand cursor-pointer",
                  isActive(href) ? "is-active" : "",
                  isActive(href)
                    ? "text-brand-orange hover:text-brand-orange-dark"
                    : "hover:text-brand-orange",
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            data-open-enquiry
            aria-label="Open the contact enquiry form"
            class="contact-btn-sweep bg-[#005057] text-white font-bold text-xs md:text-sm xl:text-base 2xl:text-lg px-3.5 md:px-4 xl:px-6 2xl:px-7 py-1.5 md:py-2 xl:py-2.5 2xl:py-3 rounded-full shadow-[0_0.35rem_0.9rem_rgba(226,149,120,0.22)] cursor-pointer decoration-none inline-flex items-center leading-none"
          >
            Contact
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const syncMobileEnquiryTrigger = () => {
    const mobileTrigger = document.querySelector("[data-open-enquiry-mobile]");
    if (mobileTrigger instanceof HTMLElement) {
      if (window.matchMedia("(max-width: 47.999rem)").matches) {
        mobileTrigger.setAttribute("data-open-enquiry", "");
      } else {
        mobileTrigger.removeAttribute("data-open-enquiry");
      }
    }
  };

  syncMobileEnquiryTrigger();
  window.addEventListener("resize", syncMobileEnquiryTrigger, { passive: true });
</script>
