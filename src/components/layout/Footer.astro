---
const isHomePage = Astro.url.pathname === "/";
---

<footer
  data-site-footer
  class="border-t border-slate-200 bg-stone-50 py-10 text-center text-xs text-slate-700 font-semibold mt-auto"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col items-center gap-5 text-center md:flex-row md:items-center md:justify-between md:gap-6 md:text-left"
    >
      <div data-site-footer-stop-target class="flex flex-col items-center md:items-start">
        <p class="font-extrabold text-brand-teal-dark text-md lg:text-lg font-sans">Septen</p>
        <p class="max-w-[32rem] text-slate-600 font-mono text-xs">
          &copy; 2026 Septen. Web Setup & Maintenance for Trades & Independent Shops.
        </p>
      </div>
      <div class="flex w-full flex-col items-center gap-3 md:w-auto md:items-end">
        <nav
          aria-label="Footer navigation"
          class="flex w-full flex-wrap justify-center gap-x-[clamp(0.875rem,4vw,1.5rem)] gap-y-2 text-xs font-bold text-slate-800 md:w-auto md:justify-end md:gap-6 md:text-sm"
        >
          <a
            href={isHomePage ? "#services" : "/#services"}
            class="hover:text-brand-orange transition-colors decoration-none">Services</a
          >
          <a
            href={isHomePage ? "#pricing" : "/#pricing"}
            class="hover:text-brand-orange transition-colors decoration-none">Pricing</a
          >
          <a
            href={isHomePage ? "#portfolio" : "/#portfolio"}
            class="hover:text-brand-orange transition-colors decoration-none">See Demos</a
          >
          <a
            href={isHomePage ? "#about" : "/#about"}
            class="hover:text-brand-orange transition-colors decoration-none">About</a
          >
          <a
            href={isHomePage ? "#faq" : "/#faq"}
            class="hover:text-brand-orange transition-colors decoration-none">FAQ</a
          >
        </nav>
        <nav
          aria-label="Legal links"
          class="flex w-full flex-wrap justify-center gap-x-[clamp(0.625rem,3vw,1rem)] gap-y-2 text-xs text-slate-700 font-semibold md:w-auto md:justify-end md:gap-4"
        >
          <a
            href="/legal/#terms"
            data-open-legal="terms"
            class="hover:text-brand-orange-dark transition-colors decoration-none">Terms</a
          >
          <a
            href="/legal/#privacy"
            data-open-legal="privacy"
            class="hover:text-brand-orange-dark transition-colors decoration-none">Privacy</a
          >
          <a
            href="/legal/#cookies"
            data-open-legal="cookies"
            class="hover:text-brand-orange-dark transition-colors decoration-none">Cookies</a
          >
          <a
            href="/legal/#data-rights"
            data-open-legal="data-rights"
            class="hover:text-brand-orange-dark transition-colors decoration-none">Data Rights</a
          >
          <a
            href="/legal/#disclaimer"
            data-open-legal="disclaimer"
            class="hover:text-brand-orange-dark transition-colors decoration-none">Disclaimer</a
          >
        </nav>
      </div>
    </div>
  </div>
</footer>
