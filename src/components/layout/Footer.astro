---
const { compact = false } = Astro.props;
---

{
  compact ? (
    <footer
      data-site-footer
      class="border-t border-slate-200 bg-stone-50 py-4 sm:py-4 md:py-5 text-center text-[0.8125rem] sm:text-[0.8125rem] md:text-sm xl:text-[13px] 2xl:text-base text-slate-700 font-semibold mt-auto shrink-0 min-h-0 flex items-center"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 2xl:px-14 w-full">
        <div class="flex flex-col items-center gap-1.5 sm:gap-1.5 md:flex-row md:items-center md:justify-between md:gap-3 xl:gap-4 text-center md:text-left">
          <p data-site-footer-stop-target class="leading-tight">
            &copy; 2026 Septen
          </p>
          <nav
            aria-label="Legal links"
            class="flex flex-wrap justify-center gap-x-2.5 sm:gap-x-3 md:gap-x-3.5 xl:gap-x-4 2xl:gap-x-5 gap-y-1 leading-tight"
          >
            <a
              href="/legal/#terms"
              data-open-legal="terms"
              class="hover:text-brand-orange-dark transition-colors decoration-none"
            >
              Terms
            </a>
            <a
              href="/legal/#privacy"
              data-open-legal="privacy"
              class="hover:text-brand-orange-dark transition-colors decoration-none"
            >
              Privacy
            </a>
            <a
              href="/legal/#cookies"
              data-open-legal="cookies"
              class="hover:text-brand-orange-dark transition-colors decoration-none"
            >
              Cookies
            </a>
            <a
              href="/legal/#data-rights"
              data-open-legal="data-rights"
              class="hover:text-brand-orange-dark transition-colors decoration-none"
            >
              Data Rights
            </a>
            <a
              href="/legal/#disclaimer"
              data-open-legal="disclaimer"
              class="hover:text-brand-orange-dark transition-colors decoration-none"
            >
              Disclaimer
            </a>
          </nav>
        </div>
      </div>
    </footer>
  ) : (
    <footer
      data-site-footer
      class="border-t border-slate-200 bg-stone-50 py-5 sm:py-5 md:py-6 text-center text-[0.8125rem] md:text-[13px] xl:text-sm 2xl:text-base text-slate-700 font-semibold mt-auto shrink-0 min-h-[var(--site-footer-height)] flex items-center"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 2xl:px-14 w-full">
        <div class="flex flex-col items-center gap-3.5 md:gap-3 text-center md:flex-row md:items-center md:justify-between md:gap-6 xl:gap-8 md:text-left">
          <div
            data-site-footer-stop-target
            class="flex flex-col items-center md:items-start shrink-0 pt-0.5 md:pt-0"
          >
            <p class="font-extrabold text-brand-teal-dark text-sm md:text-base xl:text-lg 2xl:text-xl font-sans leading-none hidden md:block">
              Septen
            </p>
            <p class="max-w-[32rem] xl:max-w-[40rem] text-slate-600 font-mono text-[0.75rem] md:text-[12px] xl:text-[13px] 2xl:text-sm leading-tight mt-0 md:mt-2.5">
              &copy; 2026 Septen. Custom Web Design & Total Management for Local Businesses.
            </p>
          </div>
          <div class="flex w-full flex-col items-center gap-2.5 md:gap-2.5 md:w-auto md:items-end">
            <nav
              aria-label="Footer navigation"
              class="flex w-full flex-wrap justify-center gap-x-[clamp(0.6rem,3vw,1.25rem)] 2xl:gap-x-8 gap-y-1 text-[0.8125rem] md:text-[13px] xl:text-sm 2xl:text-base font-bold text-slate-800 md:w-auto md:justify-end md:gap-5 xl:gap-6 2xl:gap-8"
            >
              <a href="/pricing" class="hover:text-brand-orange transition-colors decoration-none">
                Services
              </a>
              <a href="/demos" class="hover:text-brand-orange transition-colors decoration-none">
                See Demos
              </a>
              <a href="/faq" class="hover:text-brand-orange transition-colors decoration-none">
                FAQ
              </a>
              <a href="/about" class="hover:text-brand-orange transition-colors decoration-none">
                About
              </a>
              <button
                type="button"
                data-open-enquiry
                aria-label="Open the contact enquiry form"
                class="hover:text-brand-orange transition-colors decoration-none bg-transparent border-none cursor-pointer p-0 font-bold text-[0.8125rem] md:text-[13px] xl:text-sm 2xl:text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2"
              >
                Contact
              </button>
            </nav>
            <nav
              aria-label="Legal links"
              class="flex w-full flex-wrap justify-center gap-x-[clamp(0.5rem,2.25vw,0.875rem)] 2xl:gap-x-6 gap-y-1 text-[0.75rem] md:text-[12px] xl:text-[13px] 2xl:text-sm text-slate-700 font-semibold md:w-auto md:justify-end md:gap-3.5 xl:gap-4 2xl:gap-5"
            >
              <a
                href="/legal/#terms"
                data-open-legal="terms"
                class="hover:text-brand-orange-dark transition-colors decoration-none"
              >
                Terms
              </a>
              <a
                href="/legal/#privacy"
                data-open-legal="privacy"
                class="hover:text-brand-orange-dark transition-colors decoration-none"
              >
                Privacy
              </a>
              <a
                href="/legal/#cookies"
                data-open-legal="cookies"
                class="hover:text-brand-orange-dark transition-colors decoration-none"
              >
                Cookies
              </a>
              <a
                href="/legal/#data-rights"
                data-open-legal="data-rights"
                class="hover:text-brand-orange-dark transition-colors decoration-none"
              >
                Data Rights
              </a>
              <a
                href="/legal/#disclaimer"
                data-open-legal="disclaimer"
                class="hover:text-brand-orange-dark transition-colors decoration-none"
              >
                Disclaimer
              </a>
            </nav>
          </div>
        </div>
      </div>
    </footer>
  )
}
