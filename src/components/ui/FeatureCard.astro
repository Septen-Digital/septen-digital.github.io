---
interface Props {
  title: string;
  description: string;
  revealDelay?: string;
  revealType?: "fade" | "card" | "scale";
}
const { title, description, revealDelay, revealType = "card" } = Astro.props;
---

<article
  class:list={[
    "rounded-xl border border-slate-200 bg-white p-5 text-left shadow-xs transition-colors hover:border-brand-teal/50 hover:shadow-sm sm:p-6",
  ]}
  data-reveal={revealType}
  data-reveal-delay={revealDelay ?? "0"}
>
  <div class="mb-4 h-1 w-10 rounded-full bg-brand-orange" aria-hidden="true"></div>
  <h3 class="font-sans font-bold text-lg text-brand-teal">
    {title}
  </h3>
  <p class="text-sm md:text-base text-slate-600 leading-relaxed">
    {description}
  </p>
</article>
