---
type Props = {
  slug: string;
};

const { slug } = Astro.props as Props;
---

{
  slug === "carls-coffee" ? (
    <div class="bg-stone-50 p-3 text-left text-[10px] text-stone-700 h-25 overflow-hidden space-y-2">
      <p class="font-serif italic text-xs font-black text-stone-800">Carl&apos;s Coffee Board</p>
      <p class="text-[0.4375rem] text-stone-400">Durham Artisan Roasters. Freshly Baked</p>
      <div class="bg-white/80 border border-stone-200 p-1 rounded text-[0.4375rem] grid grid-cols-2">
        <span class="font-serif">Espresso Roast</span>
        <span class="text-right">&pound;2.20</span>
      </div>
    </div>
  ) : slug === "alder-and-pipe-plumbing" ? (
    <div class="bg-slate-50 p-3 text-left text-[10px] text-slate-700 h-25 overflow-hidden space-y-1.5">
      <div class="bg-blue-50 text-blue-800 text-[0.4375rem] py-0.5 text-center font-bold uppercase tracking-wider rounded">
        Domestic Plumbing Care
      </div>
      <p class="text-[0.625rem] font-serif font-bold text-slate-900">Alder &amp; Pipe Plumbing</p>
      <p class="text-[0.4375rem] text-slate-400">Reliable home maintenance across the North East</p>
    </div>
  ) : slug === "sarahs-boutique" ? (
    <div class="bg-stone-50 p-3 text-center text-[10px] text-stone-700 h-25 overflow-hidden space-y-1.5">
      <p class="font-serif italic text-xs tracking-widest uppercase text-stone-900">SARAH&apos;S</p>
      <p class="text-[0.375rem] text-stone-500 italic">Harrogate Studio. Autumn IV Collection</p>
      <div class="border border-stone-200 p-1 rounded font-serif text-[0.375rem] w-full">
        Merino Coat - &pound;149
      </div>
    </div>
  ) : slug === "greenfield-landscaping" ? (
    <div class="bg-stone-50 p-3 text-left text-[10px] text-stone-700 h-25 overflow-hidden space-y-2">
      <p class="font-serif italic text-xs font-black text-stone-800">Garden transformations</p>
      <p class="text-[0.4375rem] text-stone-400">Indian Sandstone. Morpeth Area Project</p>
      <div class="bg-emerald-50 text-emerald-800 text-[0.375rem] border border-emerald-200/40 p-1 rounded font-bold uppercase text-center tracking-wider">
        Premium Domestic Construction
      </div>
    </div>
  ) : slug === "north-shore-fitness" ? (
    <div class="bg-slate-950 p-3 text-left text-[10px] text-white h-25 overflow-hidden space-y-2">
      <p class="font-display text-xs font-black uppercase tracking-wider text-brand-orange">
        North Shore Fitness
      </p>
      <p class="text-[0.4375rem] text-slate-400">Coaching, classes, and memberships</p>
      <div class="inline-flex rounded border border-brand-orange/40 bg-brand-orange/10 px-2 py-1 text-[0.4375rem] font-bold uppercase tracking-wider text-brand-orange">
        Join Today
      </div>
    </div>
  ) : null
}
