---
import { processSteps, services } from '../../data/site';
---

<section class="deferred-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200 text-left" aria-labelledby="services-title">
  <div id="services" class="section-scroll-target">
    <h2 id="services-title" data-reveal class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight mb-10">Services</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      services.map((service, index) => (
        <div class="space-y-3 text-left" data-reveal data-reveal-delay={String(index * 60)}>
          <h3 class="font-sans font-bold text-lg text-brand-teal">{service.title}</h3>
          <p class="text-sm md:text-base text-slate-600 leading-relaxed">{service.description}</p>
        </div>
      ))
    }
  </div>

  <div data-reveal="fade" data-reveal-delay="120" class="mt-16 bg-slate-50 border border-slate-200 p-8 rounded-xl text-left">
    <h3 class="font-sans font-extrabold text-slate-500 text-xs uppercase tracking-widest mb-6">How It Works</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        processSteps.map((step, index) => (
          <div class="space-y-2" data-reveal data-reveal-delay={String(170 + index * 60)}>
            <h4 class="font-sans font-bold text-sm md:text-base text-brand-teal">{step.title}</h4>
            <p class="text-xs md:text-sm text-slate-600 leading-relaxed">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
