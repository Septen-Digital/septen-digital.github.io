---
import { aboutParagraphs, founders } from '../../data/site';
---

<section class="deferred-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200 text-center" aria-labelledby="about-title">
  <div class="space-y-10">
    <div id="about" data-reveal="fade" class="section-scroll-target space-y-6 max-w-3xl xl:max-w-5xl mx-auto text-center">
      <h2 id="about-title" class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight">About Us</h2>
      <div class="space-y-4 xl:max-w-4xl xl:mx-auto">
        {
          aboutParagraphs.map((paragraph, index) => (
            <p data-reveal="fade" data-reveal-delay={String(70 + index * 50)} class="text-sm md:text-base text-slate-600 leading-relaxed">{paragraph}</p>
          ))
        }
      </div>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-12 pt-4">
      {
        founders.map((founder, index) => (
          <div data-reveal="scale" data-reveal-delay={String(160 + index * 70)} class="flex flex-col items-center space-y-3 hover-card-polish">
            <img
              src={founder.image}
              alt={founder.alt}
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
              data-skeleton
              class="image-skeleton w-24 h-24 rounded-full object-cover"
            />
            <span class="text-sm font-semibold text-slate-800 font-sans">{founder.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
