---
import { Image } from "astro:assets";
import { aboutParagraphs, founders } from "@data/site";
---

<section
  id="about"
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200 text-center"
  aria-labelledby="about-title"
>
  <div class="space-y-10">
    <div data-reveal="fade" class="space-y-6 max-w-3xl xl:max-w-5xl mx-auto text-center">
      <h2
        id="about-title"
        class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight"
      >
        About Us
      </h2>
      <div class="space-y-4 xl:max-w-4xl xl:mx-auto">
        {
          aboutParagraphs.map((paragraph, index) => (
            <p
              data-reveal="fade"
              data-reveal-delay={String(70 + index * 50)}
              class="text-sm md:text-base text-slate-600 leading-relaxed"
            >
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>

    <div
      class="grid grid-cols-2 items-stretch gap-4 pt-4 sm:flex sm:flex-wrap sm:justify-center sm:gap-12"
    >
      {
        founders.map((founder, index) => (
          <div
            data-reveal="scale"
            data-reveal-delay={String(160 + index * 70)}
            class="founder-profile-card flex w-full flex-col items-center space-y-2 rounded-[1.75rem] px-3 py-4 sm:max-w-[240px] sm:px-5"
          >
            <Image
              src={founder.image}
              alt={founder.alt}
              width={96}
              height={96}
              loading="lazy"
              decoding="async"
              data-skeleton
              class="image-skeleton founder-profile-image mb-1 h-20 w-20 rounded-full object-cover sm:h-24 sm:w-24"
            />
            <h3 class="founder-profile-name text-center text-sm font-bold leading-none tracking-tight text-slate-800 font-sans sm:text-base">
              {founder.name}
            </h3>
            <p class="founder-profile-role line-clamp-2 text-center text-[11px] font-medium text-slate-500 font-sans balance-text sm:text-xs">
              {founder.role}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
