---
import { pricingPlans } from '../../data/site';

const contactHref = Astro.url.pathname === '/' ? '#contact' : '/#contact';
---

<section class="deferred-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200 text-left" aria-labelledby="pricing-title">
  <div id="pricing" class="section-scroll-target">
    <h2 id="pricing-title" data-reveal class="font-sans text-3xl md:text-4xl font-extrabold text-brand-teal tracking-tight mb-10">Pricing Plans</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      pricingPlans.map((plan, index) => (
        <div
          data-reveal="card"
          data-reveal-delay={String(index * 80)}
          class:list={[
              'rounded-xl p-8 md:p-10 flex flex-col justify-between text-left space-y-6 relative hover-card-polish',
            plan.featured
              ? 'bg-white border-2 border-brand-orange shadow-md'
              : 'bg-white border border-slate-300 hover:border-slate-400 transition-colors shadow-xs',
          ]}
        >
          {
            plan.featured && (
              <span class="absolute -top-3.5 right-6 bg-brand-orange text-white text-xs font-black uppercase px-3 py-1 rounded-full tracking-widest">
                Recommended
              </span>
            )
          }

          <div class="space-y-4">
            <h3 class="font-sans font-bold text-lg md:text-xl text-brand-teal">{plan.name}</h3>
            <p class="font-sans text-3xl font-extrabold text-slate-800" set:html={`${plan.price} <span class="font-sans text-xs font-normal text-slate-500">/ month</span>`} />
            <p class="text-xs md:text-sm text-slate-600 leading-relaxed">{plan.description}</p>
          </div>

          <ul class="space-y-3.5 text-xs md:text-sm pl-0 list-none m-0 border-t border-slate-200 pt-6 grow">
            {
              plan.items.map((item) => (
                <li class:list={['flex items-start gap-2', plan.featured ? 'text-stone-800 font-bold' : 'text-stone-700 font-semibold']}>
                  <span class="text-brand-orange font-bold" aria-hidden="true">&check;</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <a
            href={contactHref}
            data-open-enquiry
            data-enquiry-plan={plan.enquiryPlan}
            aria-label={`Open the enquiry form for the ${plan.name} plan`}
            class:list={[
              'block text-center w-full text-white font-bold text-xs py-3 rounded-lg transition-all font-mono uppercase tracking-widest border-none cursor-pointer mt-8 decoration-none',
              'hover-button-polish',
              plan.featured ? 'bg-brand-orange hover:bg-brand-orange-dark' : 'bg-brand-teal hover:bg-brand-teal-dark',
            ]}
          >
            {plan.ctaLabel}
          </a>
        </div>
      ))
    }
  </div>
</section>
