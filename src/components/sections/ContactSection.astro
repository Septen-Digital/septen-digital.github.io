<section
  id="contact"
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200 text-center animate-fade-in"
  aria-labelledby="contact-title"
>
  <div class="max-w-2xl mx-auto space-y-5">
    <div>
      <h2
        id="contact-title"
        data-reveal
        class="font-sans text-3xl md:text-4xl lg:text-5xl font-extrabold text-brand-teal tracking-tight"
      >
        Ready to transform your business presence?
      </h2>
    </div>
    <p
      data-reveal="fade"
      data-reveal-delay="70"
      class="text-sm md:text-base lg:text-lg text-slate-600 max-w-lg mx-auto leading-relaxed"
