{
  "name": "septen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node ./tools/clean-build-artifacts.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:code": "npm run lint",
    "astro:check": "astro check",
    "stylelint": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location .stylelintcache",
    "stylelint:fix": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location .stylelintcache --fix",
    "lint:styles": "npm run stylelint",
    "spellcheck": "cspell --no-progress src README.md",
    "ncu": "ncu",
    "html:validate": "node ./tools/html-validate-run.mjs .htmlvalidate.relaxed.json dist/404.html dist/demos && node ./tools/html-validate-run.mjs .htmlvalidate.json dist/index.html dist/about dist/demos dist/faq dist/legal dist/pricing",
    "content:check": "node ./tools/check-built-content.mjs",
    "bundle:visualize": "node ./tools/run-bundle-visualizer.mjs",
    "bundle:budget": "node ./tools/check-bundle-budget.mjs",
    "bundle:dead-code": "ts-prune -p tsconfig.json",
    "playwright:install": "playwright install chromium firefox webkit",
    "playwright": "playwright test",
    "playwright:flows": "playwright test tests/playwright/site.flows.spec.ts",
    "playwright:csp": "playwright test tests/playwright/site.csp.spec.ts",
    "playwright:visual": "playwright test tests/playwright/site.visual.spec.ts --project=chromium --workers=4",
    "playwright:visual:update": "playwright test tests/playwright/site.visual.spec.ts --project=chromium --update-snapshots --workers=4",
    "playwright:quality": "playwright test tests/playwright/site.quality.spec.ts tests/playwright/site.links.spec.ts tests/playwright/site.accessibility.spec.ts tests/playwright/site.performance.spec.ts tests/playwright/site.schema.spec.ts tests/playwright/site.viewports.spec.ts tests/playwright/site.metadata.spec.ts",
    "pa11y": "node ./tools/run-pa11y-suite.mjs",
    "recovery:test": "node ./tools/disaster-recovery.mjs",
    "test": "npm run build && npm run astro:check && npm run html:validate && npm run content:check && npm run bundle:budget && npm run bundle:dead-code && npm run spellcheck && npm run playwright:quality && npm run playwright:flows && npm run playwright:csp && npm run pa11y",
    "ci": "npm run lint && npm run format:check && npm run stylelint && npm run test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/preact": "^6.0.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "astro": "^7.1.5",
    "astro-eslint-parser": "^1.4.0",
    "cspell": "^10.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^11.4.0",
    "npm-check-updates": "^22.2.9",
    "pa11y": "^9.1.1",
    "preact": "^10.29.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vite-bundle-visualizer": "^1.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true
  }
}
