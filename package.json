{
  "name": "septen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node ./tools/clean-build-artifacts.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:code": "npm run lint",
    "astro:check": "astro check",
    "stylelint": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location .stylelintcache",
    "stylelint:fix": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location .stylelintcache --fix",
    "lint:styles": "npm run stylelint",
    "ncu": "ncu",
    "cspell": "cspell lint . --config ./cspell.json --gitignore --dot --no-progress --no-summary",
    "html:validate": "html-validate dist --config ./.htmlvalidate.json",
    "content:check": "node ./tools/check-built-content.mjs",
    "links": "node ./tools/check-links.mjs",
    "axe": "node ./tools/run-axe.mjs",
    "pa11y": "node ./tools/run-pa11y.mjs",
    "bundle:visualize": "node ./tools/run-bundle-visualizer.mjs",
    "bundle:budget": "node ./tools/check-bundle-budget.mjs",
    "bundle:dead-code": "ts-prune -p tsconfig.json",
    "lighthouse": "node ./tools/clean-lighthouse-artifacts.mjs && lhci autorun --config=./lighthouserc.json",
    "lighthouse:demos": "node ./tools/clean-lighthouse-artifacts.mjs && lhci autorun --config=./lighthouserc.demos.json",
    "playwright:install": "playwright install chromium firefox webkit",
    "playwright": "playwright test",
    "playwright:flows": "playwright test tests/playwright/site.flows.spec.ts",
    "playwright:csp": "playwright test tests/playwright/site.csp.spec.ts",
    "playwright:visual": "playwright test tests/playwright/site.visual.spec.ts --project=chromium",
    "playwright:visual:update": "playwright test tests/playwright/site.visual.spec.ts --project=chromium --update-snapshots",
    "recovery:test": "node ./tools/disaster-recovery.mjs",
    "validate": "npm run format && npm run lint && npm run astro:check && npm run stylelint:fix && npm run cspell && npm run build && npm run html:validate && npm run content:check && npm run links && npm run axe && npm run pa11y && npm run bundle:visualize && npm run bundle:budget && npm run bundle:dead-code && npm run lighthouse && npm run lighthouse:demos && npm run playwright:flows && npm run playwright:csp && npm run playwright:visual",
    "ci:validate": "npm run lint && npm run astro:check && npm run stylelint && npm run format:check && npm run cspell && npm run build && npm run html:validate && npm run content:check && npm run links && npm run axe && npm run pa11y && npm run bundle:visualize && npm run bundle:budget && npm run bundle:dead-code && npm run lighthouse && npm run lighthouse:demos && npm run playwright"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/preact": "^6.0.2",
    "@axe-core/cli": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "astro": "^7.1.5",
    "astro-eslint-parser": "^1.4.0",
    "chromedriver": "^150.0.4",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^11.4.0",
    "linkinator": "^8.0.2",
    "npm-check-updates": "^22.2.9",
    "pa11y": "^9.1.1",
    "preact": "^10.29.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vite-bundle-visualizer": "^1.2.1"
  }
}
