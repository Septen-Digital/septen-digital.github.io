{
  "extends": ["html-validate:recommended"],
  "rules": {
    "element-name": "error",
    "heading-level": "off",
    "long-title": "error",
    "meta-refresh": "error",
    "no-dup-id": "error",
    "no-implicit-button-type": "off",
    "no-inline-style": "off",
    "no-raw-characters": "off",
    "no-trailing-whitespace": "off",
    "prefer-tbody": "off",
    "tel-non-breaking": "off",
    "unique-landmark": "off",
    "void-style": "off",
    "element-permitted-content": "off"
  }
}
