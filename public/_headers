/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Origin-Agent-Cluster: ?1
  X-DNS-Prefetch-Control: off
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), fullscreen=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-5B3PFfx1nR+TzoPWXIkNGA3CFy/r4hiHncUKTwxuIYE=' 'sha256-XI/6lYNrM01zmAtSR0WTsC6kuqJd+PqG+XcYm9ne+zw='; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self' blob:; form-action 'self' https://api.web3forms.com; base-uri 'none'; prefetch-src 'self'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/demos/*
  X-Robots-Tag: noindex, nofollow
